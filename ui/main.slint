export component MainWindow inherits Window {
    preferred-width: 100%;
    preferred-height: 100%;
    title: "LibrePOS";
    background: #505050;

    in-out property <bool> sidebar-open: false;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // ----- Top Header Bar -----
        Rectangle {
            height: 56px;
            background: #101010;

            // Hamburger button
            Rectangle {
                x: 12px;
                y: 8px;
                width: 40px;
                height: 40px;
                background: sidebar-open ? #505050 : #101010;
                border-radius: 6px;

                hamburger-area := TouchArea {
                    clicked => {
                        sidebar-open = !sidebar-open;
                    }
                }

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "☰";
                    color: #00ffff;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Application title
            Text {
                x: 64px;
                y: 0px;
                height: parent.height;
                text: "LibrePOS";
                font-size: 20px;
                color: #ff0000;
                vertical-alignment: center;
            }

            // Version number (next to title)
            Text {
                x: 170px;
                y: 0px;
                height: parent.height;
                text: "v0.1.4";
                font-size: 14px;
                color: #909090;
                vertical-alignment: center;
            }
        }

        // ----- Main Content Area -----
        Rectangle {
            vertical-stretch: 1;
            background: #5a5a5a;

            // Touch area to close sidebar when clicking outside
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    sidebar-open = false;
                }
            }

            // Placeholder content
            Text {
                width: parent.width;
                height: parent.height;
                text: "Dashboard";
                font-size: 32px;
                color: #fafafa;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // ----- Overlay Sidebar -----
            Rectangle {
                x: 0px;
                y: 0px;
                width: sidebar-open ? 250px : 0px;
                height: parent.height;
                animate width { duration: 300ms; easing: ease-in-out; }
                clip: true;
                background: #707070;
                border-width: 1px;
                border-color: #808080;

                // Absorb clicks so they don't reach the background TouchArea
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                }

                VerticalLayout {
                    padding: 12px;
                    spacing: 0px;

                    // Dashboard
                    Rectangle {
                        height: 30px;
                        background: transparent;
                        TouchArea {
                            clicked => { /* no-op for now */ }
                        }
                        Text {
                            text: "Dashboard";
                            color: white;
                            font-size: 18px;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: ""; color: white; font-size: 18px; }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Text { text: ""; color: white; font-size: 18px; }
                    
                    // Reports
                    Rectangle {
                        height: 30px;
                        background: transparent;
                        TouchArea {
                            clicked => { /* no-op for now */ }
                        }
                        Text {
                            text: "Reports";
                            color: white;
                            font-size: 18px;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: ""; color: white; font-size: 18px; }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Text { text: ""; color: white; font-size: 18px; }
                    
                    // Menu
                    Rectangle {
                        height: 30px;
                        background: transparent;
                        TouchArea {
                            clicked => { /* no-op for now */ }
                        }
                        Text {
                            text: "Menu";
                            color: white;
                            font-size: 18px;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: ""; color: white; font-size: 18px; }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Text { text: ""; color: white; font-size: 18px; }
                    
                    // Settings
                    Rectangle {
                        height: 30px;
                        background: transparent;
                        TouchArea {
                            clicked => { /* no-op for now */ }
                        }
                        Text {
                            text: "Settings";
                            color: white;
                            font-size: 18px;
                            vertical-alignment: center;
                        }
                    }
                    Text { text: ""; color: white; font-size: 18px; }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Text {
                        text: "";
                        color: white;
                        font-size: 18px;
                    }
                    
                    Rectangle { vertical-stretch: 1; }

                    // Quit
                    Rectangle {
                        height: 30px;
                        background: transparent;
                        TouchArea {
                            clicked => { /* no-op for now */ }
                        }
                        Text {
                            text: "Quit";
                            color: white; font-size: 18px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Rectangle { height: 12px; }
                }
            }
        }
    }
}
