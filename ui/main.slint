export component MainWindow inherits Window {
    preferred-width: 100%;
    preferred-height: 100%;
    title: "LibrePOS";
    background: #505050;

    in-out property <bool> sidebar-open: false;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // ----- Top Header Bar -----
        Rectangle {
            height: 56px;
            background: #101010;

            // Hamburger button
            Rectangle {
                x: 12px;
                y: 8px;
                width: 40px;
                height: 40px;
                background: hamburger-area.pressed ? #505050 : #505050;
                border-radius: 6px;

                hamburger-area := TouchArea {
                    clicked => {
                        sidebar-open = !sidebar-open;
                    }
                }

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "☰";
                    color: #00ffff;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Application title
            Text {
                x: 64px;
                y: 0px;
                height: parent.height;
                text: "LibrePOS";
                font-size: 20px;
                color: #ff0000;
                vertical-alignment: center;
            }

            // Version number
            Text {
                x: 170px;
                y: 0px;
                height: parent.height;
                text: "v0.1.3";
                font-size: 14px;
                color: #909090;
                vertical-alignment: center;
            }
        }

        // ----- Main Content Area -----
        Rectangle {
            vertical-stretch: 1;
            background: #505050;

            // Placeholder content
            Text {
                width: parent.width;
                height: parent.height;
                text: "Dashboard";
                font-size: 32px;
                color: #fafafa;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // ----- Overlay Sidebar -----
            Rectangle {
                x: 0px;
                y: 0px;
                width: sidebar-open ? 250px : 0px;
                height: parent.height;
                animate width { duration: 300ms; easing: ease-in-out; }
                clip: true;
                background: #707070;

                VerticalLayout {
                    padding: 12px;
                    spacing: 0px;

                    Text { text: ""; color: white; font-size: 18px; }
                    Text { text: "Dashboard"; color: white; font-size: 18px; }
                    Text { text: ""; color: white; font-size: 18px; }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Text { text: ""; color: white; font-size: 18px; }
                    
                    Text { text: "Reports"; color: white; font-size: 18px; }
                    Text { text: ""; color: white; font-size: 18px; }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Text { text: ""; color: white; font-size: 18px; }
                    
                    Text { text: "Menu"; color: white; font-size: 18px; }
                    Text { text: ""; color: white; font-size: 18px; }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Text { text: ""; color: white; font-size: 18px; }
                    
                    Text { text: "Settings"; color: white; font-size: 18px; }
                    Text { text: ""; color: white; font-size: 18px; }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Text { text: ""; color: white; font-size: 18px; }
                    
                    Rectangle { vertical-stretch: 1; }

                    Text { text: "Quit"; color: white; font-size: 18px; }
                    Rectangle { height: 1px; background: #3a4a5a; }
                    Rectangle { height: 12px; }
                }
            }
        }
    }
}
