import { DashboardView } from "views/dashboard.slint";
import { ReportsView } from "views/reports.slint";
import { MenuView } from "views/menu.slint";
import { SettingsView, TableArea } from "views/settings.slint";
import { BillView } from "views/bill.slint";
import { ItemDetailsView } from "views/item_details.slint";
import { MenuItem, IngredientRow } from "db-types.slint";
import { TopBar } from "components/top_bar.slint";
import { SideBar } from "components/sidebar.slint";
import { QuitDialog } from "components/quit_dialog.slint";

export component MainWindow inherits Window {
    preferred-width: 100%;
    preferred-height: 100%;
    title: "LibrePOS";
    background: #505050;

    in-out property <bool> sidebar-open: false;
    in-out property <bool> quit-dialog-open: false;
    in-out property <int> current-view: 0;
    in-out property <string> current-bill-table: "";
    in property <[TableArea]> areas;
    in property <[MenuItem]> menu-items;
    in property <MenuItem> current-menu-item;
    in property <[IngredientRow]> current-ingredients;
    in-out property <string> current-price-text: "0";
    in-out property <string> name-text: "";
    in-out property <string> code-text: "";
    in-out property <string> category-text: "";
    in-out property <string> total-cost-text: "0";
    in-out property <string> profit-text: "0";

    callback quit();
    callback add-area();
    callback remove-area(int);
    callback set-tables(int, int);
    callback add-menu-item();
    callback remove-menu-item(int);
    callback open-menu-item(int);
    callback save-menu-item();
    callback cancel-menu-item();
    callback add-ingredient();
    callback remove-ingredient(int);

    callback update-ingredient-name(int, string);
    callback update-ingredient-quantity(int, string);
    callback update-ingredient-unit(int, string);
    callback update-ingredient-cost(int, string);

    VerticalLayout {
        spacing: 0px;

        TopBar {
            sidebar-open: root.sidebar-open;
            toggle-sidebar => {
                root.sidebar-open = !root.sidebar-open;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #5a5a5a;

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.sidebar-open = false;
                }
            }

            if root.current-view == 0 : DashboardView {
                areas: root.areas;
                table-selected(table) => {
                    root.current-bill-table = table;
                    root.current-view = 4;
                }
                set-tables(area-index, new-count) => {
                    root.set-tables(area-index, new-count);
                }
            }
            if root.current-view == 1 : ReportsView { }
            if root.current-view == 2 : MenuView {
                items: root.menu-items;
                add-item => { root.add-menu-item(); }
                remove-item(index) => { root.remove-menu-item(index); }
                open-item(index) => { root.open-menu-item(index); }
            }
            if root.current-view == 3 : SettingsView {
                areas: root.areas;
                add-area => { root.add-area(); }
                remove-area(index) => { root.remove-area(index); }
            }
            if root.current-view == 4 : BillView {
                table-name: root.current-bill-table;
                go-back => { root.current-view = 0; }
                save => { /* future */ }
                print => { /* future */ }
            }
            if root.current-view == 5 : ItemDetailsView {
                item: root.current-menu-item;
                ingredients: root.current-ingredients;
                name-text <=> root.name-text;
                code-text <=> root.code-text;
                price-text <=> root.current-price-text;
                category-text <=> root.category-text;
                total-cost-text <=> root.total-cost-text;
                profit-text <=> root.profit-text;
                save => { root.save-menu-item(); }
                cancel => { root.cancel-menu-item(); }
                add-ingredient => { root.add-ingredient(); }
                remove-ingredient(index) => { root.remove-ingredient(index); }
                update-ingredient-quantity(index, text) => { root.update-ingredient-quantity(index, text); }
                update-ingredient-unit(index, text) => { root.update-ingredient-unit(index, text); }
                update-ingredient-cost(index, text) => { root.update-ingredient-cost(index, text); }
                update-ingredient-name(index, text) => { root.update-ingredient-name(index, text); }
            }

            SideBar {
                x: 0px;
                y: 0px;
                width: root.sidebar-open ? 250px : 0px;
                height: parent.height;
                animate width { duration: 300ms; easing: ease-in-out; }
                clip: true;

                current-view: root.current-view;
                navigate(view) => {
                    root.current-view = view;
                    root.sidebar-open = false;
                }
                quit-requested => {
                    root.quit-dialog-open = true;
                }
            }
        }

        // Status bar
        Rectangle {
            height: 24px;
            background: #101010;
            HorizontalLayout {
                padding: 4px;
                Text { text: "User: Admin"; color: white; font-size: 12px; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "v0.2.0"; color: white; font-size: 12px; }
            }
        }
    }

    if root.quit-dialog-open : QuitDialog {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: true;
        confirmed => {
            root.quit();
        }
    }
}
