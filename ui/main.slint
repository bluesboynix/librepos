import { DashboardView } from "views/dashboard.slint";
import { ReportsView } from "views/reports.slint";
import { MenuView } from "views/menu.slint";
import { SettingsView } from "views/settings.slint";
import { BillView } from "views/bill.slint";
import { ItemDetailsView } from "views/item_details.slint";
import { MenuItem, IngredientRow, OrderLine, TableArea, ReportSummary, ReportItem, ReportPayment, ReportDay, ReportBill, BillDetail } from "db-types.slint";
import { TopBar } from "components/top_bar.slint";
import { SideBar } from "components/sidebar.slint";
import { QuitDialog } from "components/quit_dialog.slint";
import { VoidDialog } from "components/void_dialog.slint";


export component MainWindow inherits Window {
    preferred-width: 100%;
    preferred-height: 100%;
    title: "LibrePOS";
    background: #505050;

    in-out property <bool> sidebar-open: false;
    in-out property <bool> quit-dialog-open: false;
    in-out property <int> current-view: 0;
    in-out property <string> current-bill-table: "";
    in property <[TableArea]> areas;
    in property <[MenuItem]> menu-items;
    in property <[MenuItem]> filtered-menu-items;
    in property <[OrderLine]> order-lines;
    in property <MenuItem> current-menu-item;
    in property <[IngredientRow]> current-ingredients;
    in-out property <string> current-price-text: "0";
    in-out property <string> name-text: "";
    in-out property <string> code-text: "";
    in-out property <string> category-text: "";
    in-out property <string> total-cost-text: "0";
    in-out property <string> profit-text: "0";
    in-out property <float> bill-subtotal: 0.0;
    in-out property <float> bill-gst: 0.0;
    in-out property <float> bill-total: 0.0;
    in-out property <float> bill-gst-rate: 5.0;
    in-out property <string> packaging-text: "0.00";
    in-out property <string> delivery-text: "0.00";
    in-out property <string> discount-text: "0.00";
    in-out property <string> cgst-text: "0";
    in-out property <string> sgst-text: "0";
    in-out property <string> currency: "₹";
    in-out property <int> payment-mode: 0;
    in-out property <string> split-cash-text: "";
    in-out property <string> split-upi-text: "";
    in-out property <string> split-card-text: "";
    in-out property <string> menu-search-text: "";
    in-out property <string> customer-name: "";
    in-out property <string> customer-phone: "";
    in-out property <string> customer-address: "";
    in-out property <string> void-reason: "";
    in-out property <bool> void-dialog-open: false;
    in-out property <bool> bills-show-voided: false;

    // Note dialog
    in-out property <bool> note-dialog-open: false;
    in-out property <int> note-dialog-line-index: -1;
    in-out property <string> note-dialog-text: "";
    in-out property <string> note-dialog-item-name: "";

    // Reports
    in-out property <string> report-from-date: "";
    in-out property <string> report-to-date: "";
    in-out property <int> report-active-tab: 0;
    in-out property <int> report-active-range: 0;
    in property <ReportSummary> report-summary;
    in property <[ReportItem]> report-top-items;
    in property <[ReportPayment]> report-payment-breakdown;
    in property <[ReportDay]> report-daily-sales;
    in property <[ReportBill]> report-bills;
    in-out property <float> report-max-daily-sale: 0.0;
    in-out property <string> report-max-daily-sale-text: "0.00";
    in-out property <[string]> report-y-labels;
    in property <BillDetail> current-bill-detail;
    in-out property <bool> bills-detail-open: false;

    callback perform-void();
    callback toggle-voided();
    callback void-bill();
    callback revive();
    callback quit();
    callback home();
    callback add-area();
    callback remove-area(int);
    callback set-tables(int, int);
    callback update-area-name(int, string);
    callback add-menu-item();
    callback remove-menu-item(int);
    callback open-menu-item(int);
    callback save-menu-item();
    callback cancel-menu-item();
    callback add-ingredient();
    callback remove-ingredient(int);
    callback update-ingredient-name(int, string);
    callback update-ingredient-quantity(int, string);
    callback update-ingredient-unit(int, string);
    callback update-ingredient-cost(int, string);
    callback add-order-line(string, float);
    callback update-order-line-quantity(int, int);
    callback update-order-line-note(int, string);
    callback remove-order-line(int);
    callback recalculate-bill();
    callback recalculate-gst();
    callback currency-changed();
    callback filter-menu-items(string);
    callback open-table(string);
    callback save-order();
    callback save-and-close-order();
    callback close-bill();
    callback move-table(string);
    callback load-reports(string, string);
    callback reports-quick-range(int);
    callback load-bill-detail(int);
    callback clear-bill-detail();
    callback edit-bill();

    VerticalLayout {
        spacing: 0px;

        TopBar {
            sidebar-open: root.sidebar-open;
            toggle-sidebar => {
                root.sidebar-open = !root.sidebar-open;
            }
            home => {
                root.current-view = 0;
                root.sidebar-open = false;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #5a5a5a;

            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.sidebar-open = false;
                }
            }

            // Dashboard
            if root.current-view == 0 : DashboardView {
                areas: root.areas;
                currency: root.currency;
                table-selected(table) => {
                    root.open-table(table);
                }
                set-tables(area-index, new-count) => {
                    root.set-tables(area-index, new-count);
                }
            }

            // Reports
            if root.current-view == 1 : ReportsView {
                from-date <=> root.report-from-date;
                to-date <=> root.report-to-date;
                active-tab <=> root.report-active-tab;
                active-range <=> root.report-active-range;
                summary: root.report-summary;
                top-items: root.report-top-items;
                payment-breakdown: root.report-payment-breakdown;
                daily-sales: root.report-daily-sales;
                bills: root.report-bills;
                max-daily-sale: root.report-max-daily-sale;
                max-daily-sale-text: root.report-max-daily-sale-text;
                y-labels: root.report-y-labels;
                currency: root.currency;
                current-bill-detail: root.current-bill-detail;
                bills-detail-open <=> root.bills-detail-open;
                refresh(from, to) => { root.load-reports(from, to); }
                quick-range(kind) => { root.reports-quick-range(kind); }
                load-bill-detail(order-id) => { root.load-bill-detail(order-id); }
                clear-bill-detail => { root.clear-bill-detail(); }
                void-bill => { root.void-dialog-open = true; }
                bills-show-voided <=> root.bills-show-voided;
                revive => { root.revive(); }
                toggle-voided => { root.toggle-voided(); }
                edit-bill => { root.edit-bill(); }
            }

            // Menu
            if root.current-view == 2 : MenuView {
                items: root.filtered-menu-items;
                currency: root.currency;
                search-text <=> root.menu-search-text;
                search-changed(text) => { root.filter-menu-items(text); }
                add-item => { root.add-menu-item(); }
                remove-item(id) => { root.remove-menu-item(id); }
                open-item(id) => { root.open-menu-item(id); }
            }

            // Settings
            if root.current-view == 3 : SettingsView {
                areas: root.areas;
                currency: root.currency;
                cgst-text <=> root.cgst-text;
                sgst-text <=> root.sgst-text;
                add-area => { root.add-area(); }
                remove-area(index) => { root.remove-area(index); }
                update-area-name(index, name) => {
                    root.update-area-name(index, name);
                }
                gst-changed => { root.recalculate-gst(); }
                currency-changed => { root.currency-changed(); }
            }

            // Bill
            if root.current-view == 4 : BillView {
                table-name: root.current-bill-table;
                menu-items: root.filtered-menu-items;
                order-lines: root.order-lines;
                subtotal: root.bill-subtotal;
                gst: root.bill-gst;
                total: root.bill-total;
                gst-rate: root.bill-gst-rate;
                packaging-text <=> root.packaging-text;
                delivery-text <=> root.delivery-text;
                discount-text <=> root.discount-text;
                currency: root.currency;
                payment-mode <=> root.payment-mode;
                split-cash-text <=> root.split-cash-text;
                split-upi-text <=> root.split-upi-text;
                split-card-text <=> root.split-card-text;
                customer-name <=> root.customer-name;
                customer-phone <=> root.customer-phone;
                customer-address <=> root.customer-address;
                search-text <=> root.menu-search-text;
                note-dialog-open <=> root.note-dialog-open;
                note-dialog-line-index <=> root.note-dialog-line-index;
                note-dialog-text <=> root.note-dialog-text;
                note-dialog-item-name <=> root.note-dialog-item-name;
                search-changed(text) => { root.filter-menu-items(text); }
                add-order-line(name, price) => {
                    root.add-order-line(name, price);
                }
                update-order-line-quantity(index, qty) => {
                    root.update-order-line-quantity(index, qty);
                }
                update-order-line-note(index, note) => {
                    root.update-order-line-note(index, note);
                }
                remove-order-line(index) => {
                    root.remove-order-line(index);
                }
                recalculate => { root.recalculate-bill(); }
                move-table(new-table) => { root.move-table(new-table); }
                go-back => { root.close-bill(); }
                save => { root.save-and-close-order(); }
                print-order => { root.save-order(); }
            }

            // Item Details
            if root.current-view == 5 : ItemDetailsView {
                item: root.current-menu-item;
                ingredients: root.current-ingredients;
                name-text <=> root.name-text;
                code-text <=> root.code-text;
                price-text <=> root.current-price-text;
                category-text <=> root.category-text;
                currency: root.currency;
                total-cost-text <=> root.total-cost-text;
                profit-text <=> root.profit-text;
                save => { root.save-menu-item(); }
                cancel => { root.cancel-menu-item(); }
                add-ingredient => { root.add-ingredient(); }
                remove-ingredient(index) => {
                    root.remove-ingredient(index);
                }
                update-ingredient-name(index, text) => {
                    root.update-ingredient-name(index, text);
                }
                update-ingredient-quantity(index, text) => {
                    root.update-ingredient-quantity(index, text);
                }
                update-ingredient-unit(index, text) => {
                    root.update-ingredient-unit(index, text);
                }
                update-ingredient-cost(index, text) => {
                    root.update-ingredient-cost(index, text);
                }
            }

            SideBar {
                x: 0px;
                y: 0px;
                width: root.sidebar-open ? 250px : 0px;
                height: parent.height;
                animate width { duration: 300ms; easing: ease-in-out; }
                clip: true;

                current-view: root.current-view;
                navigate(view) => {
                    root.current-view = view;
                    root.sidebar-open = false;
                }
                quit-requested => {
                    root.quit-dialog-open = true;
                }
            }
        }

        // Status bar
        Rectangle {
            height: 24px;
            background: #101010;
            HorizontalLayout {
                padding: 4px;
                Text {
                    text: "User: Admin";
                    color: white;
                    font-size: 12px;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "v0.3.6a";
                    color: white;
                    font-size: 12px;
                }
            }
        }
    }

    if root.quit-dialog-open : QuitDialog {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: true;
        confirmed => {
            root.quit();
        }
    }

    if root.void-dialog-open : VoidDialog {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        reason-text <=> root.void-reason;
        confirm => {
            root.void-dialog-open = false;
            root.perform-void();
        }
        cancel => {
            root.void-dialog-open = false;
        }
    }
}
