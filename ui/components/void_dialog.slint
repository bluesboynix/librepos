import { Theme } from "../theme.slint";

export component VoidDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000aa;

    in-out property <string> reason-text: "";

    callback confirm();
    callback cancel();

    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    Rectangle {
        x: (parent.width - 480px) / 2;
        y: (parent.height - 340px) / 2;
        width: 480px;
        height: 340px;
        background: Theme.bg-panel-alt;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: Theme.btn-danger;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: "Void this bill?";
                color: Theme.btn-danger;
                font-size: 18px;
                horizontal-alignment: center;
            }

            Text {
                text: "A reason is required. This action is reversible.";
                color: Theme.text-secondary;
                font-size: 12px;
                horizontal-alignment: center;
            }

            Text {
                text: "Quick reasons:";
                color: Theme.accent;
                font-size: 13px;
            }

            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: preset1.has-hover ? Theme.btn-neutral-hover : Theme.btn-neutral;
                    border-radius: Theme.radius-sm;
                    preset1 := TouchArea {
                        clicked => { root.reason-text = "Customer cancelled"; }
                    }
                    Text {
                        text: "Customer cancelled";
                        color: Theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: preset2.has-hover ? Theme.btn-neutral-hover : Theme.btn-neutral;
                    border-radius: Theme.radius-sm;
                    preset2 := TouchArea {
                        clicked => { root.reason-text = "Wrong entry"; }
                    }
                    Text {
                        text: "Wrong entry";
                        color: Theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: preset3.has-hover ? Theme.btn-neutral-hover : Theme.btn-neutral;
                    border-radius: Theme.radius-sm;
                    preset3 := TouchArea {
                        clicked => { root.reason-text = "Duplicate"; }
                    }
                    Text {
                        text: "Duplicate";
                        color: Theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: preset4.has-hover ? Theme.btn-neutral-hover : Theme.btn-neutral;
                    border-radius: Theme.radius-sm;
                    preset4 := TouchArea {
                        clicked => { root.reason-text = "Refunded"; }
                    }
                    Text {
                        text: "Refunded";
                        color: Theme.text-primary;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: "Reason:";
                color: Theme.accent;
                font-size: 13px;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 60px;
                background: Theme.bg-input;
                border-radius: Theme.radius-sm;
                clip: true;
                HorizontalLayout {
                    padding: 6px;
                    TextInput {
                        horizontal-stretch: 1;
                        height: 100%;
                        color: black;
                        font-size: 14px;
                        wrap: word-wrap;
                        text <=> root.reason-text;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 120px;
                    height: 40px;
                    background: (root.reason-text != "" && confirm-hover.has-hover)
                        ? Theme.btn-danger-hover
                        : (root.reason-text != ""
                            ? Theme.btn-danger
                            : #555555);
                    border-radius: Theme.radius-md;
                    confirm-hover := TouchArea {
                        clicked => {
                            if root.reason-text != "" {
                                root.confirm();
                            }
                        }
                    }
                    Text {
                        text: "Void Bill";
                        color: root.reason-text != "" ? Theme.text-primary : Theme.text-dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 100px;
                    height: 40px;
                    background: cancel-hover.has-hover ? Theme.btn-neutral-hover : Theme.btn-neutral;
                    border-radius: Theme.radius-md;
                    cancel-hover := TouchArea {
                        clicked => { root.cancel(); }
                    }
                    Text {
                        text: "Cancel";
                        color: Theme.text-primary;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
