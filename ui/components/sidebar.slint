import { Theme } from "../theme.slint";

export component SideBar inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg-panel;
    border-width: 1px;
    border-color: Theme.border-line;

    in property <int> current-view: 0;
    callback navigate(int);
    callback quit-requested();

    // Absorb clicks so they don't reach the background
    TouchArea {
        width: parent.width;
        height: parent.height;
    }

    VerticalLayout {
        padding: 12px;
        spacing: 0px;

        // Dashboard
        Rectangle {
            height: 40px;
            background: dashboard-hover.has-hover ? #8a8a8a : transparent;
            dashboard-hover := TouchArea {
                clicked => { root.navigate(0); }
            }
            HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: "Dashboard";
                    color: Theme.text-primary;
                    font-size: 18px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }

        // Reports
        Rectangle {
            height: 40px;
            background: reports-hover.has-hover ? #8a8a8a : transparent;
            reports-hover := TouchArea {
                clicked => { root.navigate(1); }
            }
            HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: "Reports";
                    color: Theme.text-primary;
                    font-size: 18px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }

        // Menu
        Rectangle {
            height: 40px;
            background: menu-hover.has-hover ? #8a8a8a : transparent;
            menu-hover := TouchArea {
                clicked => { root.navigate(2); }
            }
            HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: "Menu";
                    color: Theme.text-primary;
                    font-size: 18px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }

        // Settings
        Rectangle {
            height: 40px;
            background: settings-hover.has-hover ? #8a8a8a : transparent;
            settings-hover := TouchArea {
                clicked => { root.navigate(3); }
            }
            HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: "Settings";
                    color: Theme.text-primary;
                    font-size: 18px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }

        // About
        Rectangle {
            height: 40px;
            background: about-hover.has-hover ? #8a8a8a : transparent;
            about-hover := TouchArea {
                clicked => { root.navigate(6); }
            }
            HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: "About";
                    color: Theme.text-primary;
                    font-size: 18px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }

        // Spacer
        Rectangle { vertical-stretch: 1; }

        // Quit
        Rectangle {
            height: 40px;
            background: quit-hover.has-hover ? #8a8a8a : transparent;
            quit-hover := TouchArea {
                clicked => { root.quit-requested(); }
            }
            HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: "Quit";
                    color: Theme.text-primary;
                    font-size: 18px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border-subtle; }
    }
}
