import { Theme } from "../theme.slint";

export component TableCard inherits Rectangle {
    width: 120px;
    height: 90px;
    background: selected ? Theme.accent-selected : (card-area.has-hover ? #606060 : Theme.bg-panel);
    border-radius: Theme.radius-lg;
    border-width: 2px;
    border-color: occupied ? #aa00aa : Theme.accent;

    in property <string> label: "Table";
    in property <bool> selected: false;
    in property <bool> occupied: false;
    in property <float> total: 0.0;
    in property <string> currency: "₹";
    callback clicked();

    VerticalLayout {
        alignment: center;
        spacing: Theme.pad-sm;

        Text {
            text: root.label;
            color: root.selected ? black : Theme.text-primary;
            font-size: 16px;
            horizontal-alignment: center;
        }

        if root.occupied : Text {
            text: root.currency + (Math.round(root.total * 100) / 100);
            color: root.selected ? black : Theme.text-note;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }

    card-area := TouchArea {
        clicked => { root.clicked(); }
    }
}
