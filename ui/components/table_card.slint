export component TableCard inherits Rectangle {
    width: 120px;
    height: 80px;
    background: card-area.has-hover ? #606060 : #404040;
    border-radius: 10px;
    border-width: 2px;
    border-color: #00ffff;

    in property <string> label: "Table";
    callback clicked();

    card-area := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: parent.label;
        color: white;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
