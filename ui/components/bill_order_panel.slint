import { OrderLine } from "../db-types.slint";

export component BillOrderPanel inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #404040;
    border-radius: 8px;

    in property <[OrderLine]> order-lines;
    in property <string> table-name: "Table";
    in property <string> currency: "₹";
    in-out property <string> instructions: "";

    in-out property <bool> note-dialog-open: false;
    in-out property <int> note-dialog-line-index: -1;
    in-out property <string> note-dialog-text: "";
    in-out property <string> note-dialog-item-name: "";

    callback update-order-line-quantity(int, int);
    callback remove-order-line(int);
    callback update-order-line-note(int, string);
    callback print-order();

    VerticalLayout {
        alignment: start;
        padding: 10px;
        spacing: 8px;

        Text {
            text: "Order - " + root.table-name;
            color: #00ffff;
            font-size: 20px;
            horizontal-alignment: center;
        }

        Flickable {
            viewport-width: self.width;
            viewport-height: order-layout.preferred-height;
            interactive: true;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            order-layout := VerticalLayout {
                spacing: 4px;

                for line[i] in root.order-lines : Rectangle {
                    height: line.note == "" ? 42px : 60px;
                    background: #505050;
                    border-radius: 4px;

                    VerticalLayout {
                        spacing: 2px;

                        HorizontalLayout {
                            padding: 6px;
                            spacing: 10px;

                            Text {
                                text: line.name;
                                color: white;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 24px;
                                height: 24px;
                                background: line.note != ""
                                    ? #aa8800
                                    : (note-hover.has-hover ? #888888 : #666666);
                                border-radius: 4px;
                                note-hover := TouchArea {
                                    clicked => {
                                        root.note-dialog-line-index = i;
                                        root.note-dialog-text = line.note;
                                        root.note-dialog-item-name = line.name;
                                        root.note-dialog-open = true;
                                    }
                                }
                                Text {
                                    text: "N";
                                    color: white;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: root.currency + line.price;
                                color: white;
                                font-size: 15px;
                            }
                            Text {
                                text: "x" + line.quantity;
                                color: white;
                                font-size: 15px;
                            }
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                background: dec-hover.has-hover ? #888888 : #666666;
                                border-radius: 4px;
                                dec-hover := TouchArea {
                                    clicked => {
                                        root.update-order-line-quantity(i, line.quantity - 1);
                                    }
                                }
                                Text {
                                    text: "-";
                                    color: white;
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                width: 20px;
                                height: 20px;
                                background: inc-hover.has-hover ? #888888 : #666666;
                                border-radius: 4px;
                                inc-hover := TouchArea {
                                    clicked => {
                                        root.update-order-line-quantity(i, line.quantity + 1);
                                    }
                                }
                                Text {
                                    text: "+";
                                    color: white;
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                width: 32px;
                                height: 22px;
                                background: remove-hover.has-hover ? #aa3333 : #883333;
                                border-radius: 4px;
                                remove-hover := TouchArea {
                                    clicked => {
                                        root.remove-order-line(i);
                                    }
                                }
                                Text {
                                    text: "X";
                                    color: white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    font-size: 13px;
                                }
                            }
                        }

                        if line.note != "" : HorizontalLayout {
                            padding-left: 8px;
                            Text {
                                text: "↳ " + line.note;
                                color: #ffcc00;
                                font-size: 12px;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: instructions-input.preferred-height + 12px;
            background: #d0d0d0;
            border-radius: 4px;
            clip: true;
            HorizontalLayout {
                padding: 6px;
                instructions-input := TextInput {
                    horizontal-stretch: 1;
                    height: 100%;
                    color: black;
                    wrap: word-wrap;
                    text <=> root.instructions;
                }
            }
        }

        Rectangle {
            height: 40px;
            background: print-order-hover.has-hover ? #444444 : #333333;
            border-radius: 6px;
            print-order-hover := TouchArea {
                clicked => { root.print-order(); }
            }
            Text {
                text: "Print Order";
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
