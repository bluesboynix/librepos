import { Theme } from "../theme.slint";

export component SearchBox inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #d0d0d0;
    border-radius: 4px;
    clip: true;

    in property <string> placeholder: "Search...";
    in-out property <string> text: "";
    in-out property <bool> focus-requested: false;
    in property <length> text-size: 15px;

    callback edited(string);
    callback key-pressed(string, bool, bool, bool, bool) -> bool;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;

        input := TextInput {
            horizontal-stretch: 1;
            height: 100%;
            color: black;
            font-size: root.text-size;
            single-line: true;
            vertical-alignment: center;
            text <=> root.text;
            edited => { root.edited(self.text); }
            key-pressed(event) => {
                root.key-pressed(
                    event.text,
                    event.modifiers.control,
                    event.modifiers.shift,
                    event.modifiers.alt,
                    event.modifiers.meta,
                ) ? accept : reject
            }
        }

        Rectangle {
            width: 22px;
            height: 22px;
            background: clear-hover.has-hover ? #aaaaaa : #cccccc;
            border-radius: 11px;
            clear-hover := TouchArea {
                clicked => {
                    root.text = "";
                    root.edited("");
                }
            }
            Text {
                text: "×";
                color: black;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    changed focus-requested => {
        if (self.focus-requested) {
            input.focus();
            self.focus-requested = false;
        }
    }
}
