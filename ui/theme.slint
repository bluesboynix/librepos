export global Theme {
    // Backgrounds
    out property <color> bg-window: #505050;
    out property <color> bg-topbar: #101010;
    out property <color> bg-panel: #404040;
    out property <color> bg-panel-alt: #303030;
    out property <color> bg-row-odd: #383838;
    out property <color> bg-row-even: #404040;
    out property <color> bg-row-hover: #505050;
    out property <color> bg-button: #444444;
    out property <color> bg-button-hover: #555555;
    out property <color> bg-input: #d0d0d0;
    out property <color> bg-input-alt: #fafafa;
    out property <color> bg-input-yellow: #ffffcc;
    out property <color> bg-input-blue: #ccffff;
    out property <color> bg-input-green: #ccffcc;

    // Accents
    out property <color> accent: #00ffff;
    out property <color> accent-selected: #00aa00;
    out property <color> accent-row-active: #0066aa;
    out property <color> text-primary: white;
    out property <color> text-secondary: #cccccc;
    out property <color> text-muted: #909090;
    out property <color> text-dim: #888888;
    out property <color> text-note: #ffcc00;
    out property <color> text-total: #00ff00;

    // Buttons (semantic)
    out property <color> btn-save: #004400;
    out property <color> btn-save-hover: #005500;
    out property <color> btn-print: #444400;
    out property <color> btn-print-hover: #555500;
    out property <color> btn-danger: #883333;
    out property <color> btn-danger-hover: #aa3333;
    out property <color> btn-neutral: #444444;
    out property <color> btn-neutral-hover: #555555;

    // Borders
    out property <color> border-line: #808080;
    out property <color> border-subtle: #606060;

    // Spacing
    out property <length> pad-xs: 2px;
    out property <length> pad-sm: 4px;
    out property <length> pad-md: 8px;
    out property <length> pad-lg: 12px;
    out property <length> pad-xl: 20px;

    // Radius
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 10px;
}
