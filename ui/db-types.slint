export struct MenuItem {
    id: int,
    name: string,
    code: string,
    price: float,
    category: string,
}

export struct IngredientRow {
    link_id: int,
    ingredient_id: int,
    name: string,
    quantity: float,
    unit: string,
    estimated_cost: float,
}

export struct OrderLine {
    name: string,
    price: float,
    quantity: int,
    note: string,
}

export struct TableCardModel {
    label: string,
    occupied: bool,
    total: float,
}

export struct TableArea {
    id: int,
    name: string,
    tables: int,
    cards: [TableCardModel],
}

export struct ReportSummary {
    total_sales: string,
    order_count: int,
    avg_order: string,
}

export struct ReportItem {
    name: string,
    quantity: int,
    revenue: string,
}

export struct ReportPayment {
    method: string,
    count: int,
    amount: string,
}

export struct ReportDay {
    date: string,
    sales: float,
    sales_display: string,
    orders: int,
}

export struct ReportBill {
    id: int,
    bill_no: string,
    table_name: string,
    area_name: string,
    total: string,
    closed_at: string,
    payment_status: string,
    status: string,
    void_reason: string,
    edit_count: int,
}

export struct BillLine {
    name: string,
    category: string,
    quantity: int,
    unit_price: string,
    line_total: string,
    note: string,
}

export struct BillPayment {
    method: string,
    amount: string,
}

export struct BillDetail {
    id: int,
    bill_no: string,
    table_name: string,
    area_name: string,
    closed_at: string,
    payment_status: string,
    status: string,
    void_reason: string,
    voided_at: string,
    subtotal: string,
    cgst: string,
    sgst: string,
    gst: string,
    packaging: string,
    delivery: string,
    discount: string,
    total: string,
    customer_name: string,
    customer_phone: string,
    customer_address: string,
    items: [BillLine],
    payments: [BillPayment],
    edit_history: [string],
}
