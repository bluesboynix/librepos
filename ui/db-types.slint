export struct MenuItem {
    id: int,
    name: string,
    code: string,
    price: float,
    category: string,
}

export struct IngredientRow {
    link_id: int,
    ingredient_id: int,
    name: string,
    quantity: float,
    unit: string,
    estimated_cost: float,
}

export struct OrderLine {
    name: string,
    price: float,
    quantity: int,
}

// Declare TableCardModel BEFORE TableArea so it can be referenced
export struct TableCardModel {
    label: string,
    occupied: bool,
    total: float,
}

export struct TableArea {
    id: int,
    name: string,
    tables: int,
    cards: [TableCardModel],
}

export struct ReportSummary {
    total_sales: float,
    order_count: int,
    avg_order: float,
}

export struct ReportItem {
    name: string,
    quantity: int,
    revenue: float,
}

export struct ReportPayment {
    method: string,
    amount: float,
    count: int,
}

export struct ReportDay {
    date: string,
    sales: float,
    orders: int,
}

export struct ReportBill {
    bill_no: string,
    table_name: string,
    area_name: string,
    total: float,
    closed_at: string,
    payment_status: string,
}
