import { MenuItem, IngredientRow } from "../db-types.slint";
import { Theme } from "../theme.slint";
import { ItemDetailsForm } from "../components/item_details_form.slint";
import { ItemDetailsIngredients } from "../components/item_details_ingredients.slint";

export component ItemDetailsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <MenuItem> item;
    in property <[IngredientRow]> ingredients;
    in-out property <string> name-text;
    in-out property <string> code-text;
    in-out property <string> price-text;
    in-out property <string> category-text;
    in-out property <string> total-cost-text: "0";
    in-out property <string> profit-text: "0";
    in property <string> currency: "₹";

    callback save();
    callback cancel();
    callback add-ingredient();
    callback remove-ingredient(int);
    callback update-ingredient-name(int, string);
    callback update-ingredient-quantity(int, string);
    callback update-ingredient-unit(int, string);
    callback update-ingredient-cost(int, string);

    VerticalLayout {
        padding: Theme.pad-xl;
        spacing: Theme.pad-md;

        // Header
        HorizontalLayout {
            spacing: Theme.pad-md;
            Text {
                text: "Item Details";
                font-size: 24px;
                color: #fafafa;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Rectangle {
                width: 80px;
                height: 40px;
                background: cancel-hover.has-hover ? #880000 : #660000;
                border-radius: Theme.radius-md;
                cancel-hover := TouchArea { clicked => { root.cancel(); } }
                Text {
                    text: "Cancel";
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 80px;
                height: 40px;
                background: save-hover.has-hover ? Theme.btn-save-hover : Theme.btn-save;
                border-radius: Theme.radius-md;
                save-hover := TouchArea { clicked => { root.save(); } }
                Text {
                    text: "Save";
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Basic fields
        ItemDetailsForm {
            name-text <=> root.name-text;
            code-text <=> root.code-text;
            price-text <=> root.price-text;
            category-text <=> root.category-text;
        }

        // Ingredients + summary
        ItemDetailsIngredients {
            ingredients: root.ingredients;
            total-cost-text <=> root.total-cost-text;
            profit-text <=> root.profit-text;
            add-ingredient => { root.add-ingredient(); }
            remove-ingredient(index) => { root.remove-ingredient(index); }
            update-ingredient-name(index, text) => {
                root.update-ingredient-name(index, text);
            }
            update-ingredient-quantity(index, text) => {
                root.update-ingredient-quantity(index, text);
            }
            update-ingredient-unit(index, text) => {
                root.update-ingredient-unit(index, text);
            }
            update-ingredient-cost(index, text) => {
                root.update-ingredient-cost(index, text);
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
