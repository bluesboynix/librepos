import { TableArea } from "../db-types.slint";

export component SettingsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[TableArea]> areas;
    callback add-area();
    callback remove-area(int);
    callback update-area-name(int, string);
    callback gst-changed();

    in-out property <string> cgst-text: "0";
    in-out property <string> sgst-text: "0";
    in-out property <string> currency: "₹";

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        Text {
            text: "Settings";
            font-size: 24px;
            color: #fafafa;
            horizontal-alignment: center;
        }

        // ----- Table Area Configuration -----
        VerticalLayout {
            spacing: 10px;

            Text {
                text: "Table Area Configuration";
                color: #00ffff;
                font-size: 18px;
                horizontal-alignment: left;
            }

            // Add new area button
            Rectangle {
                height: 30px;
                width: 150px;
                background: add-area-hover.has-hover ? #444444 : #333333;
                border-radius: 4px;
                add-area-hover := TouchArea {
                    clicked => { root.add-area(); }
                }
                Text {
                    text: "+ Add new Area";
                    color: white;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Dynamic area rows
            for area[i] in root.areas : HorizontalLayout {
                spacing: 10px;

                // Delete button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: del-hover.has-hover ? #aa3333 : #883333;
                    border-radius: 4px;
                    del-hover := TouchArea {
                        clicked => { root.remove-area(i); }
                    }
                    Text {
                        text: "x";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Area name input (editable)
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    TextInput {
                        horizontal-stretch: 1;
                        height: 100%;
                        color: black;
                        single-line: true;
                        text: area.name;
                        edited => { root.update-area-name(i, self.text); }
                    }
                }

                Text {
                    text: "Table";
                    color: white;
                    vertical-alignment: center;
                }

                // Table count input (read-only for now)
                Rectangle {
                    width: 60px;
                    height: 30px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    TextInput {
                        width: 100%;
                        height: 100%;
                        color: black;
                        single-line: true;
                        text: area.tables + "";
                    }
                }
            }
        }

        // ----- GST Configuration -----
        VerticalLayout {
            spacing: 10px;

            Text {
                text: "GST Configuration";
                color: #00ffff;
                font-size: 18px;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "CGST %:";
                    color: white;
                    width: 80px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 80px;
                    height: 30px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    TextInput {
                        width: 100%;
                        height: 100%;
                        color: black;
                        single-line: true;
                        text <=> root.cgst-text;
                        edited => { root.gst-changed(); }
                    }
                }
                Text {
                    text: "SGST %:";
                    color: white;
                    width: 80px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 80px;
                    height: 30px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    TextInput {
                        width: 100%;
                        height: 100%;
                        color: black;
                        single-line: true;
                        text <=> root.sgst-text;
                        edited => { root.gst-changed(); }
                    }
                }
            }

            HorizontalLayout {
                Text {
                    text: "Total GST:";
                    color: white;
                    width: 80px;
                    vertical-alignment: center;
                }
                Text {
                    text: (root.cgst-text.to-float() + root.sgst-text.to-float()) + "%";
                    color: #00ff00;
                    vertical-alignment: center;
                }
            }
        }

        // ----- Currency Setting -----
        VerticalLayout {
            spacing: 10px;

            Text {
                text: "Currency";
                color: #00ffff;
                font-size: 18px;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Symbol:";
                    color: white;
                    width: 80px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 80px;
                    height: 30px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    TextInput {
                        width: 100%;
                        height: 100%;
                        color: black;
                        single-line: true;
                        text <=> root.currency;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
