import { ScrollView } from "std-widgets.slint";
import { ReportPayment } from "../../db-types.slint";

export component ReportPaymentsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[ReportPayment]> payments;
    in property <string> currency: "₹";

    VerticalLayout {
        padding: 15px;
        spacing: 10px;

        // Header
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            Text { text: "Method"; color: #00ffff; font-weight: 700; font-size: 16px; width: 200px; }
            Text { text: "Count"; color: #00ffff; font-weight: 700; font-size: 16px; width: 120px; horizontal-alignment: center; }
            Text { text: "Amount"; color: #00ffff; font-weight: 700; font-size: 16px; width: 160px; horizontal-alignment: right; }
            Rectangle { horizontal-stretch: 1; } // Spacer to absorb remaining space
        }
        Rectangle { height: 1px; background: #808080; }

        // Rows
        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 5px;
                for p[i] in root.payments : Rectangle {
                    height: 48px;
                    background: Math.mod(i, 2) == 0 ? #383838 : #404040;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Text {
                            text: p.method;
                            color: white;
                            font-size: 16px;
                            width: 200px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: p.count;
                            color: white;
                            font-size: 16px;
                            width: 120px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.currency + p.amount;
                            color: #00ff00;
                            font-size: 16px;
                            width: 160px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; } // Spacer to absorb remaining space
                    }
                }
            }
        }
    }
}
