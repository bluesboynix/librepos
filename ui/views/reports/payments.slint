import { ReportPayment } from "../../db-types.slint";

export component ReportPaymentsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[ReportPayment]> payments;
    in property <string> currency: "₹";

    VerticalLayout {
        padding: 15px;
        spacing: 8px;

        Text {
            text: "Payments";
            color: #00ffff;
            font-size: 18px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Text { text: "Method"; color: #00ffff; font-weight: 700; horizontal-stretch: 1; }
            Text { text: "Count"; color: #00ffff; font-weight: 700; width: 80px; horizontal-alignment: center; }
            Text { text: "Amount"; color: #00ffff; font-weight: 700; width: 130px; horizontal-alignment: right; }
        }
        Rectangle { height: 1px; background: #808080; }

        Flickable {
            viewport-width: self.width;
            viewport-height: inner.preferred-height;
            interactive: true;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            inner := VerticalLayout {
                spacing: 4px;
                for p[i] in root.payments : Rectangle {
                    height: 40px;
                    background: Math.mod(i, 2) == 0 ? #383838 : #404040;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: p.method;
                            color: white;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: p.count;
                            color: white;
                            width: 80px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.currency + p.amount;
                            color: #00ff00;
                            width: 130px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
