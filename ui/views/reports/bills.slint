import { ReportBill } from "../../db-types.slint";

export component ReportBillsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[ReportBill]> bills;
    in property <string> currency: "₹";

    VerticalLayout {
        padding: 15px;
        spacing: 8px;

        Text {
            text: "Bills";
            color: #00ffff;
            font-size: 18px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Text { text: "Bill No"; color: #00ffff; font-weight: 700; width: 140px; }
            Text { text: "Table"; color: #00ffff; font-weight: 700; width: 130px; }
            Text { text: "Area"; color: #00ffff; font-weight: 700; width: 90px; }
            Text { text: "Total"; color: #00ffff; font-weight: 700; width: 100px; horizontal-alignment: right; }
            Text { text: "Closed At"; color: #00ffff; font-weight: 700; width: 160px; }
            Text { text: "Status"; color: #00ffff; font-weight: 700; horizontal-stretch: 1; }
        }
        Rectangle { height: 1px; background: #808080; }

        Flickable {
            viewport-width: self.width;
            viewport-height: inner.preferred-height;
            interactive: true;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            inner := VerticalLayout {
                spacing: 4px;
                for b[i] in root.bills : Rectangle {
                    height: 36px;
                    background: Math.mod(i, 2) == 0 ? #383838 : #404040;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: b.bill-no;
                            color: white;
                            width: 140px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.table-name;
                            color: white;
                            width: 130px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.area-name;
                            color: white;
                            width: 90px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.currency + b.total;
                            color: #00ff00;
                            width: 100px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.closed-at;
                            color: #cccccc;
                            width: 160px;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.payment-status;
                            color: b.payment-status == "paid" ? #00ff00 : #ffaa00;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
