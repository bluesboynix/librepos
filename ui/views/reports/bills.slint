import { ScrollView } from "std-widgets.slint";
import { ReportBill, BillDetail } from "../../db-types.slint";
import { BillDetailView } from "bill_detail.slint";

export component ReportBillsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[ReportBill]> bills;
    in property <string> currency: "₹";
    in property <BillDetail> detail;
    in-out property <bool> detail-open: false;
    in-out property <bool> show-voided: false;

    callback bill-selected(int);
    callback back-to-list();
    callback void-bill();
    callback revive();
    callback toggle-voided();
    callback edit-bill();

    // ---- Detail view (when a bill is selected) ----
    if root.detail-open : BillDetailView {
        detail: root.detail;
        currency: root.currency;
        back => { root.back-to-list(); }
        void-bill => { root.void-bill(); }
        revive => { root.revive(); }
        edit-bill => { root.edit-bill(); }
    }

    // ---- List view ----
    if !root.detail-open : VerticalLayout {
        padding: 15px;
        spacing: 8px;

        // Toggle row
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 22px;
                height: 22px;
                background: root.show-voided ? #0066aa : #444444;
                border-radius: 4px;
                TouchArea {
                    clicked => { root.toggle-voided(); }
                }
                Text {
                    text: root.show-voided ? "✓" : "";
                    color: white;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "Show voided bills";
                color: white;
                font-size: 13px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        // Column headers
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Text { text: "Bill No"; color: #00ffff; font-weight: 700; width: 140px; }
            Text { text: "Table"; color: #00ffff; font-weight: 700; width: 120px; }
            Text { text: "Area"; color: #00ffff; font-weight: 700; width: 80px; }
            Text { text: "Total"; color: #00ffff; font-weight: 700; width: 100px; horizontal-alignment: right; }
            Text { text: "Closed At"; color: #00ffff; font-weight: 700; width: 160px; }
            Text { text: "Status"; color: #00ffff; font-weight: 700; horizontal-stretch: 1; }
        }
        Rectangle { height: 1px; background: #808080; }

        // Scrollable list
        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 4px;
                for b[i] in root.bills : Rectangle {
                    height: 36px;
                    background: row-hover.has-hover
                        ? #505050
                        : (b.status == "void"
                            ? #4a1010
                            : (Math.mod(i, 2) == 0 ? #383838 : #404040));
                    border-radius: 4px;

                    row-hover := TouchArea {
                        clicked => { root.bill-selected(b.id); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text { text: b.bill-no; color: white; width: 140px; vertical-alignment: center; }
                        Text { text: b.table-name; color: white; width: 120px; vertical-alignment: center; }
                        Text { text: b.area-name; color: white; width: 80px; vertical-alignment: center; }
                        Text { text: root.currency + b.total; color: #00ff00; width: 100px; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: b.closed-at; color: #cccccc; width: 160px; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: b.status == "void" ? "voided" : b.payment-status;
                            color: b.status == "void" ? #ff6666 : (b.payment-status == "paid" ? #00ff00 : #ffaa00);
                            width: 80px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.edit-count > 0 ? "edit " + b.edit-count + "x" : "";
                            color: #ffaa00;
                            font-size: 11px;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
