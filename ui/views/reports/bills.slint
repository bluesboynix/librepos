import { ScrollView } from "std-widgets.slint";
import { ReportBill, BillDetail } from "../../db-types.slint";
import { BillDetailView } from "bill_detail.slint";

export component ReportBillsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[ReportBill]> bills;
    in property <string> currency: "₹";
    in property <BillDetail> detail;
    in property <string> total-text: "";
    in-out property <bool> detail-open: false;
    in-out property <bool> show-voided: false;
    in-out property <string> search-text: "";
    in-out property <bool> focus-search-requested: false;

    callback bill-selected(int);
    callback back-to-list();
    callback void-bill();
    callback revive();
    callback toggle-voided();
    callback search-changed(string);
    callback edit-bill();
    callback preview-bill();
    callback key-pressed(string, bool, bool, bool, bool) -> bool;

    // ---- Detail view ----
    if root.detail-open : BillDetailView {
        detail: root.detail;
        currency: root.currency;
        back => { root.back-to-list(); }
        void-bill => { root.void-bill(); }
        revive => { root.revive(); }
        edit-bill => { root.edit-bill(); }
        preview-bill => { root.preview-bill(); }
    }

    // ---- List view ----
    if !root.detail-open : VerticalLayout {
        padding: 15px;
        spacing: 10px;

        // Search + Total + Show voided row
        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                horizontal-stretch: 1;
                height: 38px;
                background: #d0d0d0;
                border-radius: 4px;
                clip: true;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 6px;
                    search-box := TextInput {
                        horizontal-stretch: 1;
                        height: 100%;
                        color: black;
                        single-line: true;
                        font-size: 16px;
                        vertical-alignment: center;
                        text <=> root.search-text;
                        edited => { root.search-changed(self.text); }
                        key-pressed(event) => {
                            root.key-pressed(
                                event.text,
                                event.modifiers.control,
                                event.modifiers.shift,
                                event.modifiers.alt,
                                event.modifiers.meta,
                            ) ? accept : reject
                        }
                    }
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        background: clear-hover.has-hover ? #aaaaaa : #cccccc;
                        border-radius: 12px;
                        clear-hover := TouchArea {
                            clicked => {
                                root.search-text = "";
                                root.search-changed("");
                            }
                        }
                        Text {
                            text: "×";
                            color: black;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Total display
            Rectangle {
                height: 38px;
                background: #202020;
                border-radius: 4px;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: root.total-text == ""
                            ? ""
                            : "Total: " + root.currency + root.total-text;
                        color: #00ff00;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        height: 100%;
                    }
                }
            }

            // Show voided checkbox
            Rectangle {
                width: 24px;
                height: 24px;
                background: root.show-voided ? #0066aa : #444444;
                border-radius: 4px;
                TouchArea {
                    clicked => { root.toggle-voided(); }
                }
                Text {
                    text: root.show-voided ? "✓" : "";
                    color: white;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "Show voided";
                color: white;
                font-size: 15px;
                vertical-alignment: center;
            }
        }

        // ---- Column headers ----
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            Text { text: "Bill No"; color: #00ffff; font-weight: 700; font-size: 16px; width: 130px; }
            Text { text: "Table"; color: #00ffff; font-weight: 700; font-size: 16px; width: 100px; }
            Text { text: "Area"; color: #00ffff; font-weight: 700; font-size: 16px; width: 80px; }
            Text { text: "Total"; color: #00ffff; font-weight: 700; font-size: 16px; width: 90px; horizontal-alignment: right; }
            Text { text: "Closed At"; color: #00ffff; font-weight: 700; font-size: 16px; width: 150px; }
            Text { text: "Status"; color: #00ffff; font-weight: 700; font-size: 16px; width: 80px; }
            Text { text: "Mode"; color: #00ffff; font-weight: 700; font-size: 16px; width: 80px; }
            Text { text: "Customer Name"; color: #00ffff; font-weight: 700; font-size: 16px; width: 140px; }
            Text { text: "Phone"; color: #00ffff; font-weight: 700; font-size: 16px; width: 110px; }
        }
        Rectangle { height: 1px; background: #808080; }

        // ---- Bill list ----
        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 5px;
                for b[i] in root.bills : Rectangle {
                    height: 44px;
                    background: row-hover.has-hover
                        ? #505050
                        : (b.status == "void"
                            ? #4a1010
                            : (Math.mod(i, 2) == 0 ? #383838 : #404040));
                    border-radius: 4px;

                    row-hover := TouchArea {
                        clicked => { root.bill-selected(b.id); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: b.bill-no;
                            color: white;
                            font-size: 16px;
                            width: 130px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.table-name;
                            color: white;
                            font-size: 16px;
                            width: 100px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.area-name;
                            color: white;
                            font-size: 16px;
                            width: 80px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.currency + b.total;
                            color: #00ff00;
                            font-size: 16px;
                            width: 90px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.closed-at;
                            color: #cccccc;
                            font-size: 14px;
                            width: 150px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.status == "void" ? "voided" : b.payment-status;
                            color: b.status == "void"
                                ? #ff6666
                                : (b.payment-status == "paid" ? #00ff00 : #ffaa00);
                            font-size: 16px;
                            width: 80px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.payment-methods;
                            color: #aaaaaa;
                            font-size: 14px;
                            width: 80px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.customer-name;
                            color: white;
                            font-size: 15px;
                            width: 140px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: b.customer-phone;
                            color: #cccccc;
                            font-size: 15px;
                            width: 110px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
