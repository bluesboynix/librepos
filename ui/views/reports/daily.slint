import { ScrollView } from "std-widgets.slint";
import { ReportDay } from "../../db-types.slint";

export component ReportDailyView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[ReportDay]> days;
    in property <string> currency: "₹";

    VerticalLayout {
        padding: 15px;
        spacing: 10px;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            Text { text: "Date"; color: #00ffff; font-weight: 700; font-size: 16px; width: 160px; }
            Text { text: "Orders"; color: #00ffff; font-weight: 700; font-size: 16px; width: 120px; horizontal-alignment: center; }
            Text { text: "Sales"; color: #00ffff; font-weight: 700; font-size: 16px; horizontal-stretch: 1; horizontal-alignment: right; }
        }
        Rectangle { height: 1px; background: #808080; }

        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 5px;
                for d[i] in root.days : Rectangle {
                    height: 44px;
                    background: Math.mod(i, 2) == 0 ? #383838 : #404040;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        Text {
                            text: d.date;
                            color: white;
                            font-size: 16px;
                            width: 160px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: d.orders;
                            color: white;
                            font-size: 16px;
                            width: 120px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.currency + d.sales_display;
                            color: #00ff00;
                            font-size: 16px;
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
