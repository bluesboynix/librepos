import { ReportItem } from "../../db-types.slint";

export component ReportItemsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[ReportItem]> items;
    in property <string> currency: "₹";

    VerticalLayout {
        padding: 15px;
        spacing: 8px;

        Text {
            text: "Top Items";
            color: #00ffff;
            font-size: 18px;
            horizontal-alignment: center;
        }

        // Header row
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Text { text: "#"; color: #00ffff; font-weight: 700; width: 40px; }
            Text { text: "Item"; color: #00ffff; font-weight: 700; horizontal-stretch: 1; }
            Text { text: "Qty"; color: #00ffff; font-weight: 700; width: 80px; horizontal-alignment: center; }
            Text { text: "Revenue"; color: #00ffff; font-weight: 700; width: 120px; horizontal-alignment: right; }
        }
        Rectangle { height: 1px; background: #808080; }

        Flickable {
            viewport-width: self.width;
            viewport-height: inner.preferred-height;
            interactive: true;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            inner := VerticalLayout {
                spacing: 4px;
                for item[i] in root.items : Rectangle {
                    height: 36px;
                    background: Math.mod(i, 2) == 0 ? #383838 : #404040;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: (i + 1);
                            color: #cccccc;
                            width: 40px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: item.name;
                            color: white;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: item.quantity;
                            color: white;
                            width: 80px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.currency + item.revenue;
                            color: #00ff00;
                            width: 120px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
