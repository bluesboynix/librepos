import { ScrollView } from "std-widgets.slint";
import { ReportItem } from "../../db-types.slint";
import { Theme } from "../../theme.slint";

export component ReportItemsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[ReportItem]> items;
    in property <[string]> categories;
    in property <string> currency: "₹";
    in-out property <string> active-category: "";

    callback filter-changed(string);

    VerticalLayout {
        padding: 15px;
        spacing: 8px;

        // Category tabs
        Flickable {
            height: 36px;
            viewport-width: cat-row.preferred-width;
            viewport-height: parent.height;
            interactive: true;

            cat-row := HorizontalLayout {
                spacing: 4px;

                Rectangle {
                    width: 80px;
                    height: 36px;
                    background: root.active-category == ""
                        ? Theme.accent-row-active
                        : Theme.btn-neutral;
                    border-radius: Theme.radius-sm;
                    TouchArea {
                        clicked => {
                            root.active-category = "";
                            root.filter-changed("");
                        }
                    }
                    Text {
                        text: "All";
                        color: white;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for cat in root.categories : Rectangle {
                    width: 110px;
                    height: 36px;
                    background: root.active-category == cat
                        ? Theme.accent-row-active
                        : Theme.btn-neutral;
                    border-radius: Theme.radius-sm;
                    TouchArea {
                        clicked => {
                            root.active-category = cat;
                            root.filter-changed(cat);
                        }
                    }
                    Text {
                        text: cat;
                        color: white;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Header
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Text { text: "#"; color: #00ffff; font-weight: 700; width: 40px; }
            Text { text: "Item"; color: #00ffff; font-weight: 700; horizontal-stretch: 1; }
            Text { text: "Category"; color: #00ffff; font-weight: 700; width: 120px; }
            Text { text: "Qty"; color: #00ffff; font-weight: 700; width: 80px; horizontal-alignment: center; }
            Text { text: "Revenue"; color: #00ffff; font-weight: 700; width: 120px; horizontal-alignment: right; }
        }
        Rectangle { height: 1px; background: #808080; }

        ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 4px;
                for item[i] in root.items : Rectangle {
                    height: 36px;
                    background: Math.mod(i, 2) == 0 ? #383838 : #404040;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: (i + 1);
                            color: #cccccc;
                            width: 40px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: item.name;
                            color: white;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: item.category;
                            color: #cccccc;
                            width: 120px;
                            vertical-alignment: center;
                            font-size: 13px;
                        }
                        Text {
                            text: item.quantity;
                            color: white;
                            width: 80px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.currency + item.revenue;
                            color: #00ff00;
                            width: 120px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
