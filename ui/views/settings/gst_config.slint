import { Theme } from "../../theme.slint";

export component GstConfigSection inherits Rectangle {
    width: 100%;
    background: transparent;

    in-out property <string> cgst-text: "0";
    in-out property <string> sgst-text: "0";

    callback gst-changed();

    VerticalLayout {
        spacing: Theme.pad-md;

        Text {
            text: "GST Configuration";
            color: Theme.accent;
            font-size: 18px;
            horizontal-alignment: left;
        }

        HorizontalLayout {
            spacing: Theme.pad-md;
            Text {
                text: "CGST %:";
                color: Theme.text-primary;
                width: 80px;
                vertical-alignment: center;
            }
            Rectangle {
                width: 80px;
                height: 30px;
                background: Theme.bg-input;
                border-radius: Theme.radius-sm;
                clip: true;
                TextInput {
                    width: 100%;
                    height: 100%;
                    color: black;
                    single-line: true;
                    text <=> root.cgst-text;
                    edited => { root.gst-changed(); }
                }
            }
            Text {
                text: "SGST %:";
                color: Theme.text-primary;
                width: 80px;
                vertical-alignment: center;
            }
            Rectangle {
                width: 80px;
                height: 30px;
                background: Theme.bg-input;
                border-radius: Theme.radius-sm;
                clip: true;
                TextInput {
                    width: 100%;
                    height: 100%;
                    color: black;
                    single-line: true;
                    text <=> root.sgst-text;
                    edited => { root.gst-changed(); }
                }
            }
        }

        HorizontalLayout {
            Text {
                text: "Total GST:";
                color: Theme.text-primary;
                width: 80px;
                vertical-alignment: center;
            }
            Text {
                text: (root.cgst-text.to-float() + root.sgst-text.to-float()) + "%";
                color: Theme.text-total;
                vertical-alignment: center;
            }
        }
    }
}
