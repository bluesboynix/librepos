import { TableArea } from "../db-types.slint";
import { AreaSection } from "../components/area_section.slint";
import { Theme } from "../theme.slint";

export component DashboardView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[TableArea]> areas;
    in property <string> currency: "₹";
    in-out property <string> selected-table: "";
    callback table-selected(string);
    callback set-tables(int, int);

    VerticalLayout {
        padding: Theme.pad-xl;
        spacing: Theme.pad-xl;

        Text {
            text: "Dashboard";
            font-size: 24px;
            color: #fafafa;
            horizontal-alignment: center;
        }

        for area[i] in root.areas : AreaSection {
            area: area;
            area-index: i;
            selected-table <=> root.selected-table;
            currency: root.currency;
            table-selected(table) => { root.table-selected(table); }
            set-tables(area-index, new-count) => {
                root.set-tables(area-index, new-count);
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
