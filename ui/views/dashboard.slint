import { TableCard } from "../components/table_card.slint";
import { TableArea } from "../db-types.slint";

export component DashboardView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[TableArea]> areas;
    in-out property <string> selected-table: "";
    callback table-selected(string);
    callback set-tables(int, int);

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        Text {
            text: "Dashboard";
            font-size: 24px;
            color: #fafafa;
            horizontal-alignment: center;
        }

        for area[i] in root.areas : VerticalLayout {
            spacing: 10px;

            Text {
                text: area.name;
                font-size: 18px;
                color: #00ffff;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                spacing: 15px;

                for card in area.cards : TableCard {
                    width: 120px;
                    height: 80px;
                    label: card.label;
                    selected: root.selected-table == card.label;
                    occupied: card.occupied;
                    clicked => {
                        root.selected-table = self.label;
                        root.table-selected(self.label);
                    }
                }

                // Plus and minus buttons
                Rectangle {
                    width: 40px;
                    height: 40px;
                    background: plus-hover.has-hover ? #555555 : #444444;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #00ffff;
                    plus-hover := TouchArea {
                        clicked => { root.set-tables(i, area.tables + 1); }
                    }
                    Text { text: "+"; color: white; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    width: 40px;
                    height: 40px;
                    background: minus-hover.has-hover ? #555555 : #444444;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #00ffff;
                    minus-hover := TouchArea {
                        clicked => { root.set-tables(i, area.tables - 1); }
                    }
                    Text { text: "-"; color: white; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
