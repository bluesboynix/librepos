import { TableCard } from "../components/table_card.slint";

export component DashboardView inherits Rectangle {
    width: 100%;
    height: 100%;
    callback table-selected(string);

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        Text {
            text: "Dashboard";
            font-size: 24px;
            color: #fafafa;
            horizontal-alignment: center;
        }

        // ----- Indoor Section -----
        VerticalLayout {
            spacing: 10px;

            Text {
                text: "Indoor";
                font-size: 18px;
                color: #00ffff;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                spacing: 15px;

                TableCard {
                    label: "Table 1";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Table 2";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Table 3";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Table 4";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Table 5";
                    clicked => { root.table-selected(self.label); }
                }
            }
        }

        // ----- Outdoor Section -----
        VerticalLayout {
            spacing: 10px;

            Text {
                text: "Outdoor";
                font-size: 18px;
                color: #00ffff;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                spacing: 15px;

                TableCard {
                    label: "Outdoor 1";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Outdoor 2";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Outdoor 3";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Outdoor 4";
                    clicked => { root.table-selected(self.label); }
                }
            }
        }

        // ----- Delivery / Take Away Section -----
        VerticalLayout {
            spacing: 10px;

            Text {
                text: "Delivery / Take Away";
                font-size: 18px;
                color: #00ffff;
                horizontal-alignment: left;
            }

            HorizontalLayout {
                spacing: 15px;

                TableCard {
                    label: "Delivery 1";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Delivery 2";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Take Away 3";
                    clicked => { root.table-selected(self.label); }
                }
                TableCard {
                    label: "Delivery 4";
                    clicked => { root.table-selected(self.label); }
                }

                // Plus and minus buttons (visual only)
                Rectangle {
                    width: 40px;
                    height: 40px;
                    background: #505050;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #00ffff;

                    TouchArea {
                        clicked => { /* future */ }
                    }

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "+";
                        color: white;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 40px;
                    height: 40px;
                    background: #505050;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #00ffff;

                    TouchArea {
                        clicked => { /* future */ }
                    }

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "-";
                        color: white;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
