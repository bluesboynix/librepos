import { TableArea } from "../db-types.slint";
import { AreaSection } from "../components/area_section.slint";
import { Theme } from "../theme.slint";

export component DashboardView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[TableArea]> areas;
    in property <string> currency: "₹";
    in-out property <string> selected-table: "";
    callback table-selected(string);
    callback set-tables(int, int);
    callback refresh-dashboard();

    VerticalLayout {
        padding: Theme.pad-xl;
        spacing: Theme.pad-xl;

        // Header: title + refresh button
        HorizontalLayout {
            spacing: Theme.pad-md;

            Text {
                text: "Dashboard";
                font-size: 24px;
                color: #fafafa;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Rectangle {
                width: 90px;
                height: 32px;
                background: refresh-hover.has-hover
                    ? Theme.btn-neutral-hover
                    : Theme.btn-neutral;
                border-radius: Theme.radius-sm;
                refresh-hover := TouchArea {
                    clicked => { root.refresh-dashboard(); }
                }
                Text {
                    text: "↻ Refresh";
                    color: white;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        for area[i] in root.areas : AreaSection {
            area: area;
            area-index: i;
            selected-table <=> root.selected-table;
            currency: root.currency;
            table-selected(table) => { root.table-selected(table); }
            set-tables(area-index, new-count) => {
                root.set-tables(area-index, new-count);
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
