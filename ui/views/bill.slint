export component BillView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <string> table-name: "Table";
    in-out property <int> payment-mode: 0;
    in-out property <string> search-text: "";
    in-out property <string> instructions: "";
    in-out property <string> customer-name: "";
    in-out property <string> customer-phone: "";
    in-out property <string> customer-address: "";
    in-out property <string> new-table: "";
    in-out property <string> new-area: "";
    in-out property <string> bill-no: "001";
    callback go-back();
    callback save();
    callback print();
    callback print-order();

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: 15px;
        spacing: 15px;

        // ----- Left column: Menu panel (30%) -----
        Rectangle {
            width: 30%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Menu";
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Search box (expandable vertically)
                Rectangle {
                    horizontal-stretch: 1;
                    height: search-input.preferred-height + 12px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        search-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.search-text;
                        }
                    }
                }

                // Menu items (filtered)
                if root.search-text == "" || root.search-text == "Coffee" : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Coffee"; color: white; horizontal-stretch: 1; }
                        Text { text: "$12.50"; color: white; }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: add-hover1.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            add-hover1 := TouchArea { clicked => { /* future */ } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                if root.search-text == "" || root.search-text == "Milk" : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Milk"; color: white; horizontal-stretch: 1; }
                        Text { text: "$2.10"; color: white; }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: add-hover2.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            add-hover2 := TouchArea { clicked => { /* future */ } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                if root.search-text == "" || root.search-text == "Bread" : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Bread"; color: white; horizontal-stretch: 1; }
                        Text { text: "$3.75"; color: white; }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: add-hover3.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            add-hover3 := TouchArea { clicked => { /* future */ } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                if root.search-text == "" || root.search-text == "Sugar" : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Sugar"; color: white; horizontal-stretch: 1; }
                        Text { text: "$1.90"; color: white; }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: add-hover4.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            add-hover4 := TouchArea { clicked => { /* future */ } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // ----- Center column: Order items (40%) -----
        Rectangle {
            width: 40%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Order - " + root.table-name;
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Dummy order items
                Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Coffee"; color: white; horizontal-stretch: 1; }
                        Text { text: "x2"; color: white; }
                        Text { text: "$25.00"; color: white; }
                    }
                }
                Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Milk"; color: white; horizontal-stretch: 1; }
                        Text { text: "x1"; color: white; }
                        Text { text: "$2.10"; color: white; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // Optional instructions input (expandable vertically)
                Rectangle {
                    horizontal-stretch: 1;
                    height: instructions-input.preferred-height + 12px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding: 6px;
                        instructions-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.instructions;
                        }
                    }
                }

                // Print Order button
                Rectangle {
                    height: 40px;
                    background: print-order-hover.has-hover ? #444444 : #333333;
                    border-radius: 6px;
                    print-order-hover := TouchArea { clicked => { root.print-order(); } }
                    Text { text: "Print Order"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // ----- Right column: Bill summary (30%) -----
        Rectangle {
            width: 30%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Bill Summary";
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Bill number
                HorizontalLayout {
                    Text { text: "Bill No:"; color: white; width: 60px; vertical-alignment: center; }
                    Text { text: root.bill-no; color: white; horizontal-stretch: 1; vertical-alignment: center; }
                }

                // Totals
                HorizontalLayout {
                    Text { text: "Subtotal:"; color: white; horizontal-stretch: 1; }
                    Text { text: "$27.10"; color: white; }
                }
                HorizontalLayout {
                    Text { text: "GST (5%):"; color: white; horizontal-stretch: 1; }
                    Text { text: "$1.36"; color: white; }
                }
                HorizontalLayout {
                    Text { text: "Container charge:"; color: white; horizontal-stretch: 1; }
                    Text { text: "$0.50"; color: white; }
                }
                HorizontalLayout {
                    Text { text: "Delivery charge:"; color: white; horizontal-stretch: 1; }
                    Text { text: "$2.00"; color: white; }
                }
                HorizontalLayout {
                    Text { text: "Discount:"; color: white; horizontal-stretch: 1; }
                    Text { text: "-$1.00"; color: white; }
                }
                HorizontalLayout {
                    Text { text: "Total:"; color: #00ff00; font-weight: 700; horizontal-stretch: 1; }
                    Text { text: "$29.96"; color: #00ff00; font-weight: 700; }
                }

                Rectangle { height: 10px; }

                Text {
                    text: "Payment Mode";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 1 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 1; } }
                        Text { text: "Cash"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 2 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 2; } }
                        Text { text: "UPI"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 3 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 3; } }
                        Text { text: "Card"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 4 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 4; } }
                        Text { text: "Split"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 5 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 5; } }
                        Text { text: "Due"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                // Split payment inputs (expandable vertically)
                if root.payment-mode == 4 : Rectangle {
                    background: #303030;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;

                        HorizontalLayout {
                            Text { text: "Cash:"; color: white; width: 60px; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: cash-input.preferred-height + 12px;
                                background: #ffffcc;
                                border-radius: 2px;
                                clip: true;
                                cash-input := TextInput {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    color: black;
                                    wrap: word-wrap;
                                    text: "";
                                }
                            }
                        }
                        HorizontalLayout {
                            Text { text: "UPI:"; color: white; width: 60px; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: upi-input.preferred-height + 12px;
                                background: #ffffcc;
                                border-radius: 2px;
                                clip: true;
                                upi-input := TextInput {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    color: black;
                                    wrap: word-wrap;
                                    text: "";
                                }
                            }
                        }
                        HorizontalLayout {
                            Text { text: "Card:"; color: white; width: 60px; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: card-input.preferred-height + 12px;
                                background: #ffffcc;
                                border-radius: 2px;
                                clip: true;
                                card-input := TextInput {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    color: black;
                                    wrap: word-wrap;
                                    text: "";
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 10px; }

                // Action buttons
                Rectangle {
                    height: 40px;
                    background: save-hover.has-hover ? #005500 : #004400;
                    border-radius: 6px;
                    save-hover := TouchArea { clicked => { root.save(); } }
                    Text { text: "Save & Close"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    height: 40px;
                    background: print-hover.has-hover ? #555500 : #444400;
                    border-radius: 6px;
                    print-hover := TouchArea { clicked => { root.print(); } }
                    Text { text: "Print Bill"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    height: 40px;
                    background: close-hover.has-hover ? #880000 : #660000;
                    border-radius: 6px;
                    close-hover := TouchArea { clicked => { root.go-back(); } }
                    Text { text: "Dashboard"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                }

                // Customer details section (expandable vertically)
                Text {
                    text: "Customer Details";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    Text { text: "Name:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: customer-name-input.preferred-height + 12px;
                        background: #ccffff;
                        border-radius: 2px;
                        clip: true;
                        customer-name-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.customer-name;
                        }
                    }
                }
                HorizontalLayout {
                    Text { text: "Phone:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: customer-phone-input.preferred-height + 12px;
                        background: #ccffff;
                        border-radius: 2px;
                        clip: true;
                        customer-phone-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.customer-phone;
                        }
                    }
                }
                HorizontalLayout {
                    Text { text: "Address:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: customer-address-input.preferred-height + 12px;
                        background: #ccffff;
                        border-radius: 2px;
                        clip: true;
                        customer-address-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.customer-address;
                        }
                    }
                }

                // Change table section (expandable vertically)
                Text {
                    text: "Change Table";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    Text { text: "Current:"; color: white; width: 60px; vertical-alignment: center; }
                    Text { text: root.table-name; color: #00ff00; horizontal-stretch: 1; vertical-alignment: center; }
                }
                HorizontalLayout {
                    Text { text: "Table:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: new-table-input.preferred-height + 12px;
                        background: #ccffcc;
                        border-radius: 2px;
                        clip: true;
                        new-table-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.new-table;
                        }
                    }
                }
                HorizontalLayout {
                    Text { text: "Area:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: new-area-input.preferred-height + 12px;
                        background: #ccffcc;
                        border-radius: 2px;
                        clip: true;
                        new-area-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.new-area;
                        }
                    }
                }
                Rectangle {
                    height: 30px;
                    background: move-hover.has-hover ? #444444 : #333333;
                    border-radius: 4px;
                    move-hover := TouchArea { clicked => { /* future: move table */ } }
                    Text { text: "Move Table"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
