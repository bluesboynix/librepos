import { MenuItem, OrderLine } from "../db-types.slint";
import { BillMenuPanel } from "../components/bill_menu_panel.slint";
import { BillOrderPanel } from "../components/bill_order_panel.slint";
import { BillSummary } from "../components/bill_summary.slint";

export component BillView inherits Rectangle {
    width: 100%;
    height: 100%;

    in-out property <bool> focus-search-requested: false;
    in-out property <string> table-name: "Table";
    in-out property <int> payment-mode: 0;
    in-out property <string> search-text: "";
    in-out property <string> instructions: "";
    in-out property <string> customer-name: "";
    in-out property <string> customer-phone: "";
    in-out property <string> customer-address: "";
    in-out property <string> new-table: "";
    in-out property <string> new-area: "";
    in-out property <string> bill-no: "001";
    in property <[MenuItem]> menu-items;
    in property <[OrderLine]> order-lines;
    in-out property <string> discount-text: "0.00";
    in-out property <string> delivery-text: "0.00";
    in-out property <string> packaging-text: "0.00";
    in property <float> subtotal;
    in property <float> gst;
    in property <float> total;
    in property <float> gst-rate: 0.0;
    in property <string> currency: "₹";
    in-out property <string> split-cash-text: "";
    in-out property <string> split-upi-text: "";
    in-out property <string> split-card-text: "";

    in-out property <bool> note-dialog-open: false;
    in-out property <int> note-dialog-line-index: -1;
    in-out property <string> note-dialog-text: "";
    in-out property <string> note-dialog-item-name: "";

    callback go-back();
    callback save();
    callback print();
    callback print-order();
    callback add-order-line(string, float);
    callback update-order-line-quantity(int, int);
    callback remove-order-line(int);
    callback update-order-line-note(int, string);
    callback recalculate();
    callback move-table(string);
    callback search-changed(string);
    callback key-pressed(string, bool, bool, bool, bool) -> bool;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: 15px;
        spacing: 15px;

        // ----- Left: Menu -----
        BillMenuPanel {
            width: 30%;
            menu-items: root.menu-items;
            currency: root.currency;
            search-text <=> root.search-text;
            search-changed(text) => { root.search-changed(text); }
            add-order-line(name, price) => { root.add-order-line(name, price); }
            focus-search-requested <=> root.focus-search-requested;
            key-pressed(text, ctrl, shift, alt, meta) => {
                root.key-pressed(text, ctrl, shift, alt, meta)
            }
        }

        // ----- Center: Order -----
        BillOrderPanel {
            width: 40%;
            order-lines: root.order-lines;
            table-name: root.table-name;
            currency: root.currency;
            instructions <=> root.instructions;
            note-dialog-open <=> root.note-dialog-open;
            note-dialog-line-index <=> root.note-dialog-line-index;
            note-dialog-text <=> root.note-dialog-text;
            note-dialog-item-name <=> root.note-dialog-item-name;
            update-order-line-quantity(index, qty) => {
                root.update-order-line-quantity(index, qty);
            }
            remove-order-line(index) => { root.remove-order-line(index); }
            update-order-line-note(index, note) => {
                root.update-order-line-note(index, note);
            }
            print-order => { root.print-order(); }
        }

        // ----- Right: Bill Summary -----
        BillSummary {
            width: 30%;

            bill-no: root.bill-no;
            subtotal: root.subtotal;
            gst: root.gst;
            total: root.total;
            gst-rate: root.gst-rate;
            currency: root.currency;
            table-name: root.table-name;

            packaging-text <=> root.packaging-text;
            delivery-text <=> root.delivery-text;
            discount-text <=> root.discount-text;
            payment-mode <=> root.payment-mode;
            split-cash-text <=> root.split-cash-text;
            split-upi-text <=> root.split-upi-text;
            split-card-text <=> root.split-card-text;
            customer-name <=> root.customer-name;
            customer-phone <=> root.customer-phone;
            customer-address <=> root.customer-address;
            new-area <=> root.new-area;
            new-table <=> root.new-table;

            save => { root.save(); }
            print => { root.print(); }
            go-back => { root.go-back(); }
            recalculate => { root.recalculate(); }
            move-table(new-table) => { root.move-table(new-table); }
        }
    }

    // ==================== NOTE DIALOG ====================
    if root.note-dialog-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            x: (parent.width - 400px) / 2;
            y: (parent.height - 200px) / 2;
            width: 400px;
            height: 200px;
            background: #303030;
            border-radius: 8px;
            border-width: 2px;
            border-color: #00ffff;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "Note for: " + root.note-dialog-item-name;
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 60px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding: 6px;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.note-dialog-text;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 80px;
                        height: 34px;
                        background: save-note-hover.has-hover ? #005500 : #004400;
                        border-radius: 6px;
                        save-note-hover := TouchArea {
                            clicked => {
                                root.update-order-line-note(
                                    root.note-dialog-line-index,
                                    root.note-dialog-text,
                                );
                                root.note-dialog-open = false;
                                root.note-dialog-text = "";
                            }
                        }
                        Text {
                            text: "Save";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 80px;
                        height: 34px;
                        background: clear-note-hover.has-hover ? #aa3333 : #883333;
                        border-radius: 6px;
                        clear-note-hover := TouchArea {
                            clicked => {
                                root.note-dialog-text = "";
                            }
                        }
                        Text {
                            text: "Clear";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 80px;
                        height: 34px;
                        background: cancel-note-hover.has-hover ? #555555 : #444444;
                        border-radius: 6px;
                        cancel-note-hover := TouchArea {
                            clicked => {
                                root.note-dialog-open = false;
                            }
                        }
                        Text {
                            text: "Cancel";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
