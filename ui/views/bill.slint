import { MenuItem, OrderLine } from "../db-types.slint";

export component BillView inherits Rectangle {
    width: 100%;
    height: 100%;

    in-out property <string> table-name: "Table";
    in-out property <int> payment-mode: 0;
    in-out property <string> search-text: "";
    in-out property <string> instructions: "";
    in-out property <string> customer-name: "";
    in-out property <string> customer-phone: "";
    in-out property <string> customer-address: "";
    in-out property <string> new-table: "";
    in-out property <string> new-area: "";
    in-out property <string> bill-no: "001";
    in property <[MenuItem]> menu-items;
    in property <[OrderLine]> order-lines;
    in-out property <string> discount-text: "0.00";
    in-out property <string> delivery-text: "0.00";
    in-out property <string> packaging-text: "0.00";
    in property <float> subtotal;
    in property <float> gst;
    in property <float> total;
    in property <float> gst-rate: 0.0;
    in property <string> currency: "₹";
    in-out property <string> split-cash-text: "";
    in-out property <string> split-upi-text: "";
    in-out property <string> split-card-text: "";

    // Note dialog state
    in-out property <bool> note-dialog-open: false;
    in-out property <int> note-dialog-line-index: -1;
    in-out property <string> note-dialog-text: "";
    in-out property <string> note-dialog-item-name: "";

    callback go-back();
    callback save();
    callback print();
    callback print-order();
    callback add-order-line(string, float);
    callback update-order-line-quantity(int, int);
    callback remove-order-line(int);
    callback update-order-line-note(int, string);
    callback recalculate();
    callback move-table(string);
    callback search-changed(string);

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: 15px;
        spacing: 15px;

        // ----- Left column: Menu (30%) -----
        Rectangle {
            width: 30%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                alignment: start;
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Menu";
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Search box
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.search-text;
                            edited => { root.search-changed(self.text); }
                        }
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: clear-search-hover.has-hover ? #aaaaaa : #cccccc;
                            border-radius: 10px;
                            clear-search-hover := TouchArea {
                                clicked => {
                                    root.search-text = "";
                                    root.search-changed("");
                                }
                            }
                            Text {
                                text: "×";
                                color: black;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Scrollable menu items
                Flickable {
                    viewport-width: self.width;
                    viewport-height: menu-layout.preferred-height;
                    interactive: true;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    menu-layout := VerticalLayout {
                        spacing: 4px;
                        for item[i] in root.menu-items : Rectangle {
                            height: 36px;
                            background: #505050;
                            border-radius: 4px;

                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => {
                                    root.add-order-line(item.name, item.price);
                                }
                            }

                            HorizontalLayout {
                                padding: 4px;
                                spacing: 8px;

                                Text {
                                    text: item.name;
                                    color: white;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: item.category;
                                    color: #cccccc;
                                    font-size: 12px;
                                }
                                Text {
                                    text: root.currency + item.price;
                                    color: white;
                                }
                                Rectangle {
                                    width: 26px;
                                    height: 26px;
                                    background: add-hover.has-hover ? #888888 : #666666;
                                    border-radius: 4px;
                                    add-hover := TouchArea {
                                        clicked => {
                                            root.add-order-line(item.name, item.price);
                                        }
                                    }
                                    Text {
                                        text: "+";
                                        color: white;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ----- Center column: Order (40%) -----
        Rectangle {
            width: 40%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                alignment: start;
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Order - " + root.table-name;
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Scrollable order lines
                Flickable {
                    viewport-width: self.width;
                    viewport-height: order-layout.preferred-height;
                    interactive: true;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    order-layout := VerticalLayout {
                        spacing: 4px;

                        for line[i] in root.order-lines : Rectangle {
                            height: line.note == "" ? 36px : 52px;
                            background: #505050;
                            border-radius: 4px;

                            VerticalLayout {
                                spacing: 2px;

                                HorizontalLayout {
                                    padding: 4px;
                                    spacing: 8px;

                                    Text {
                                        text: line.name;
                                        color: white;
                                        horizontal-stretch: 1;
                                    }

                                    // Note button
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        background: line.note != ""
                                            ? #aa8800
                                            : (note-hover.has-hover ? #888888 : #666666);
                                        border-radius: 4px;
                                        note-hover := TouchArea {
                                            clicked => {
                                                root.note-dialog-line-index = i;
                                                root.note-dialog-text = line.note;
                                                root.note-dialog-item-name = line.name;
                                                root.note-dialog-open = true;
                                            }
                                        }
                                        Text {
                                            text: "N";
                                            color: white;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: root.currency + line.price;
                                        color: white;
                                    }
                                    Text {
                                        text: "x" + line.quantity;
                                        color: white;
                                    }
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        background: dec-hover.has-hover ? #888888 : #666666;
                                        border-radius: 4px;
                                        dec-hover := TouchArea {
                                            clicked => {
                                                root.update-order-line-quantity(i, line.quantity - 1);
                                            }
                                        }
                                        Text {
                                            text: "-";
                                            color: white;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        background: inc-hover.has-hover ? #888888 : #666666;
                                        border-radius: 4px;
                                        inc-hover := TouchArea {
                                            clicked => {
                                                root.update-order-line-quantity(i, line.quantity + 1);
                                            }
                                        }
                                        Text {
                                            text: "+";
                                            color: white;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        width: 30px;
                                        height: 20px;
                                        background: remove-hover.has-hover ? #aa3333 : #883333;
                                        border-radius: 4px;
                                        remove-hover := TouchArea {
                                            clicked => {
                                                root.remove-order-line(i);
                                            }
                                        }
                                        Text {
                                            text: "X";
                                            color: white;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            font-size: 12px;
                                        }
                                    }
                                }

                                if line.note != "" : HorizontalLayout {
                                    padding-left: 8px;
                                    Text {
                                        text: "↳ " + line.note;
                                        color: #ffcc00;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }
                }

                // Instructions input
                Rectangle {
                    horizontal-stretch: 1;
                    height: instructions-input.preferred-height + 12px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding: 6px;
                        instructions-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.instructions;
                        }
                    }
                }

                // Print Order button
                Rectangle {
                    height: 40px;
                    background: print-order-hover.has-hover ? #444444 : #333333;
                    border-radius: 6px;
                    print-order-hover := TouchArea {
                        clicked => { root.print-order(); }
                    }
                    Text {
                        text: "Print Order";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ----- Right column: Bill summary (30%) -----
        Rectangle {
            width: 30%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                alignment: start;
                padding: 10px;
                spacing: 6px;

                Text {
                    text: "Bill Summary";
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    Text {
                        text: "Bill No:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.bill-no;
                        color: white;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    Text {
                        text: "Subtotal:";
                        color: white;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.currency + root.subtotal;
                        color: white;
                    }
                }

                HorizontalLayout {
                    Text {
                        text: "GST (" + root.gst-rate + "%):";
                        color: white;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.currency + root.gst;
                        color: white;
                    }
                }

                HorizontalLayout {
                    Text {
                        text: "Packaging:";
                        color: white;
                        width: 80px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #d0d0d0;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.packaging-text;
                            edited => { root.recalculate(); }
                        }
                    }
                }

                HorizontalLayout {
                    Text {
                        text: "Delivery:";
                        color: white;
                        width: 80px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #d0d0d0;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.delivery-text;
                            edited => { root.recalculate(); }
                        }
                    }
                }

                HorizontalLayout {
                    Text {
                        text: "Discount:";
                        color: white;
                        width: 80px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #d0d0d0;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.discount-text;
                            edited => { root.recalculate(); }
                        }
                    }
                }

                HorizontalLayout {
                    Text {
                        text: "Total:";
                        color: #00ff00;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.currency + root.total;
                        color: #00ff00;
                        font-weight: 700;
                    }
                }

                Rectangle { height: 6px; }

                Text {
                    text: "Payment Mode";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 1 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 1; } }
                        Text {
                            text: "Cash";
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 2 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 2; } }
                        Text {
                            text: "UPI";
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 3 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 3; } }
                        Text {
                            text: "Card";
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 4 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 4; } }
                        Text {
                            text: "Split";
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 5 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 5; } }
                        Text {
                            text: "Due";
                            color: white;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.payment-mode == 4 : Rectangle {
                    background: #303030;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        HorizontalLayout {
                            Text {
                                text: "Cash:";
                                color: white;
                                width: 60px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                background: #ffffcc;
                                border-radius: 2px;
                                clip: true;
                                TextInput {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    color: black;
                                    single-line: true;
                                    text <=> root.split-cash-text;
                                }
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "UPI:";
                                color: white;
                                width: 60px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                background: #ffffcc;
                                border-radius: 2px;
                                clip: true;
                                TextInput {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    color: black;
                                    single-line: true;
                                    text <=> root.split-upi-text;
                                }
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "Card:";
                                color: white;
                                width: 60px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                background: #ffffcc;
                                border-radius: 2px;
                                clip: true;
                                TextInput {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    color: black;
                                    single-line: true;
                                    text <=> root.split-card-text;
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 6px; }

                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        background: save-hover.has-hover ? #005500 : #004400;
                        border-radius: 6px;
                        save-hover := TouchArea { clicked => { root.save(); } }
                        Text {
                            text: "Save & Close";
                            color: white;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        background: print-hover.has-hover ? #555500 : #444400;
                        border-radius: 6px;
                        print-hover := TouchArea { clicked => { root.print(); } }
                        Text {
                            text: "Print Bill";
                            color: white;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        background: close-hover.has-hover ? #880000 : #660000;
                        border-radius: 6px;
                        close-hover := TouchArea { clicked => { root.go-back(); } }
                        Text {
                            text: "Dashboard";
                            color: white;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { height: 6px; }

                Text {
                    text: "Customer Details";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    Text {
                        text: "Name:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffff;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.customer-name;
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Phone:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffff;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.customer-phone;
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Address:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffff;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.customer-address;
                        }
                    }
                }

                Text {
                    text: "Change Table";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    Text {
                        text: "Current:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.table-name;
                        color: #00ff00;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Area:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffcc;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.new-area;
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Table:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffcc;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.new-table;
                        }
                    }
                }
                Rectangle {
                    height: 30px;
                    background: move-hover.has-hover ? #444444 : #333333;
                    border-radius: 4px;
                    move-hover := TouchArea {
                        clicked => {
                            if root.new-area != "" && root.new-table != "" {
                                root.move-table(root.new-area + " " + root.new-table);
                                root.new-area = "";
                                root.new-table = "";
                            }
                        }
                    }
                    Text {
                        text: "Move Table";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }

    // ==================== NOTE DIALOG ====================
    if root.note-dialog-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000aa;

        // Absorb background clicks
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            x: (parent.width - 400px) / 2;
            y: (parent.height - 200px) / 2;
            width: 400px;
            height: 200px;
            background: #303030;
            border-radius: 8px;
            border-width: 2px;
            border-color: #00ffff;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "Note for: " + root.note-dialog-item-name;
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 60px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding: 6px;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.note-dialog-text;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 80px;
                        height: 34px;
                        background: save-note-hover.has-hover ? #005500 : #004400;
                        border-radius: 6px;
                        save-note-hover := TouchArea {
                            clicked => {
                                root.update-order-line-note(
                                    root.note-dialog-line-index,
                                    root.note-dialog-text,
                                );
                                root.note-dialog-open = false;
                                root.note-dialog-text = "";
                            }
                        }
                        Text {
                            text: "Save";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 80px;
                        height: 34px;
                        background: clear-note-hover.has-hover ? #aa3333 : #883333;
                        border-radius: 6px;
                        clear-note-hover := TouchArea {
                            clicked => {
                                root.note-dialog-text = "";
                            }
                        }
                        Text {
                            text: "Clear";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        width: 80px;
                        height: 34px;
                        background: cancel-note-hover.has-hover ? #555555 : #444444;
                        border-radius: 6px;
                        cancel-note-hover := TouchArea {
                            clicked => {
                                root.note-dialog-open = false;
                            }
                        }
                        Text {
                            text: "Cancel";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
