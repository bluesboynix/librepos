export component BillView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <string> table-name: "Table";
    in-out property <int> payment-mode: 0;
    in-out property <string> search-text: "";
    in-out property <string> instructions: "";
    in-out property <string> customer-name: "";
    in-out property <string> customer-phone: "";
    in-out property <string> customer-address: "";
    in-out property <string> new-table: "";
    in-out property <string> new-area: "";
    in-out property <string> bill-no: "001";
    callback go-back();
    callback save();
    callback print();
    callback print-order();

    // Editable charge/discount fields
    in-out property <string> discount-text: "1.00";
    in-out property <string> delivery-text: "2.00";
    in-out property <string> packaging-text: "0.50";

    // Order quantities (demo items)
    in-out property <int> qty-coffee: 0;
    in-out property <int> qty-milk: 0;
    in-out property <int> qty-bread: 0;
    in-out property <int> qty-sugar: 0;

    // Prices
    property <float> price-coffee: 12.50;
    property <float> price-milk: 2.10;
    property <float> price-bread: 3.75;
    property <float> price-sugar: 1.90;

    // Computed totals (using editable fields via to-float())
    property <float> subtotal: qty-coffee * price-coffee + qty-milk * price-milk + qty-bread * price-bread + qty-sugar * price-sugar;
    property <float> gst: subtotal * 0.05;
    property <float> total: subtotal + gst + packaging-text.to-float() + delivery-text.to-float() - discount-text.to-float();

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: 15px;
        spacing: 15px;

        // ----- Left column: Menu panel (30%) -----
        Rectangle {
            width: 30%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Menu";
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Search box with clear button
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.search-text;
                        }
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: clear-search-hover.has-hover ? #aaaaaa : #cccccc;
                            border-radius: 10px;
                            clear-search-hover := TouchArea {
                                clicked => { root.search-text = ""; }
                            }
                            Text {
                                text: "×";
                                color: black;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Menu items with add buttons
                if root.search-text == "" || "Coffee".to-lowercase() == root.search-text.to-lowercase() : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Coffee"; color: white; horizontal-stretch: 1; }
                        Text { text: "$12.50"; color: white; }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: add-coffee.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            add-coffee := TouchArea { clicked => { root.qty-coffee += 1; } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                if root.search-text == "" || "Milk".to-lowercase() == root.search-text.to-lowercase() : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Milk"; color: white; horizontal-stretch: 1; }
                        Text { text: "$2.10"; color: white; }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: add-milk.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            add-milk := TouchArea { clicked => { root.qty-milk += 1; } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                if root.search-text == "" || "Bread".to-lowercase() == root.search-text.to-lowercase() : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Bread"; color: white; horizontal-stretch: 1; }
                        Text { text: "$3.75"; color: white; }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: add-bread.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            add-bread := TouchArea { clicked => { root.qty-bread += 1; } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                if root.search-text == "" || "Sugar".to-lowercase() == root.search-text.to-lowercase() : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Sugar"; color: white; horizontal-stretch: 1; }
                        Text { text: "$1.90"; color: white; }
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            background: add-sugar.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            add-sugar := TouchArea { clicked => { root.qty-sugar += 1; } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // ----- Center column: Order items (40%) -----
        Rectangle {
            width: 40%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Order - " + root.table-name;
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Conditional order rows (only show if qty > 0)
                if root.qty-coffee > 0 : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Coffee"; color: white; horizontal-stretch: 1; }
                        Text { text: "x" + root.qty-coffee; color: white; }
                        Text { text: "$" + (root.qty-coffee * root.price-coffee); color: white; }
                        Rectangle { width: 20px; height: 20px; background: dec-coffee.has-hover ? #888888 : #666666; border-radius: 4px;
                            dec-coffee := TouchArea { clicked => { if root.qty-coffee > 0 { root.qty-coffee -= 1; } } }
                            Text { text: "-"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 20px; height: 20px; background: inc-coffee.has-hover ? #888888 : #666666; border-radius: 4px;
                            inc-coffee := TouchArea { clicked => { root.qty-coffee += 1; } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 40px; height: 20px; background: remove-coffee.has-hover ? #aa3333 : #883333; border-radius: 4px;
                            remove-coffee := TouchArea { clicked => { root.qty-coffee = 0; } }
                            Text { text: "X"; color: white; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; } }
                    }
                }

                if root.qty-milk > 0 : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Milk"; color: white; horizontal-stretch: 1; }
                        Text { text: "x" + root.qty-milk; color: white; }
                        Text { text: "$" + (root.qty-milk * root.price-milk); color: white; }
                        Rectangle { width: 20px; height: 20px; background: dec-milk.has-hover ? #888888 : #666666; border-radius: 4px;
                            dec-milk := TouchArea { clicked => { if root.qty-milk > 0 { root.qty-milk -= 1; } } }
                            Text { text: "-"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 20px; height: 20px; background: inc-milk.has-hover ? #888888 : #666666; border-radius: 4px;
                            inc-milk := TouchArea { clicked => { root.qty-milk += 1; } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 40px; height: 20px; background: remove-milk.has-hover ? #aa3333 : #883333; border-radius: 4px;
                            remove-milk := TouchArea { clicked => { root.qty-milk = 0; } }
                            Text { text: "X"; color: white; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; } }
                    }
                }

                if root.qty-bread > 0 : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Bread"; color: white; horizontal-stretch: 1; }
                        Text { text: "x" + root.qty-bread; color: white; }
                        Text { text: "$" + (root.qty-bread * root.price-bread); color: white; }
                        Rectangle { width: 20px; height: 20px; background: dec-bread.has-hover ? #888888 : #666666; border-radius: 4px;
                            dec-bread := TouchArea { clicked => { if root.qty-bread > 0 { root.qty-bread -= 1; } } }
                            Text { text: "-"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 20px; height: 20px; background: inc-bread.has-hover ? #888888 : #666666; border-radius: 4px;
                            inc-bread := TouchArea { clicked => { root.qty-bread += 1; } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 40px; height: 20px; background: remove-bread.has-hover ? #aa3333 : #883333; border-radius: 4px;
                            remove-bread := TouchArea { clicked => { root.qty-bread = 0; } }
                            Text { text: "X"; color: white; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; } }
                    }
                }

                if root.qty-sugar > 0 : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 6px;
                        Text { text: "Sugar"; color: white; horizontal-stretch: 1; }
                        Text { text: "x" + root.qty-sugar; color: white; }
                        Text { text: "$" + (root.qty-sugar * root.price-sugar); color: white; }
                        Rectangle { width: 20px; height: 20px; background: dec-sugar.has-hover ? #888888 : #666666; border-radius: 4px;
                            dec-sugar := TouchArea { clicked => { if root.qty-sugar > 0 { root.qty-sugar -= 1; } } }
                            Text { text: "-"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 20px; height: 20px; background: inc-sugar.has-hover ? #888888 : #666666; border-radius: 4px;
                            inc-sugar := TouchArea { clicked => { root.qty-sugar += 1; } }
                            Text { text: "+"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                        Rectangle { width: 40px; height: 20px; background: remove-sugar.has-hover ? #aa3333 : #883333; border-radius: 4px;
                            remove-sugar := TouchArea { clicked => { root.qty-sugar = 0; } }
                            Text { text: "X"; color: white; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; } }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // Optional instructions input (expandable vertically)
                Rectangle {
                    horizontal-stretch: 1;
                    height: instructions-input.preferred-height + 12px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding: 6px;
                        instructions-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.instructions;
                        }
                    }
                }

                // Print Order button
                Rectangle {
                    height: 40px;
                    background: print-order-hover.has-hover ? #444444 : #333333;
                    border-radius: 6px;
                    print-order-hover := TouchArea { clicked => { root.print-order(); } }
                    Text { text: "Print Order"; color: white; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        // ----- Right column: Bill summary (30%) -----
        Rectangle {
            width: 30%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Bill Summary";
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Bill number
                HorizontalLayout {
                    Text { text: "Bill No:"; color: white; width: 60px; vertical-alignment: center; }
                    Text { text: root.bill-no; color: white; horizontal-stretch: 1; vertical-alignment: center; }
                }

                // Totals (subtotal and GST)
                HorizontalLayout {
                    Text { text: "Subtotal:"; color: white; horizontal-stretch: 1; }
                    Text { text: "$" + root.subtotal; color: white; }
                }
                HorizontalLayout {
                    Text { text: "GST (5%):"; color: white; horizontal-stretch: 1; }
                    Text { text: "$" + root.gst; color: white; }
                }

                Rectangle { height: 8px; }

                // Editable charges and discount
                Text {
                    text: "Charges & Discounts";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    Text { text: "Packaging:"; color: white; width: 80px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; height: 26px; background: #d0d0d0; border-radius: 2px; clip: true;
                        TextInput { horizontal-stretch: 1; height: 100%; color: black; single-line: true; text <=> root.packaging-text; } }
                }
                HorizontalLayout {
                    Text { text: "Delivery:"; color: white; width: 80px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; height: 26px; background: #d0d0d0; border-radius: 2px; clip: true;
                        TextInput { horizontal-stretch: 1; height: 100%; color: black; single-line: true; text <=> root.delivery-text; } }
                }
                HorizontalLayout {
                    Text { text: "Discount:"; color: white; width: 80px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; height: 26px; background: #d0d0d0; border-radius: 2px; clip: true;
                        TextInput { horizontal-stretch: 1; height: 100%; color: black; single-line: true; text <=> root.discount-text; } }
                }

                Rectangle { height: 8px; }

                // Total (dynamic)
                HorizontalLayout {
                    Text { text: "Total:"; color: #00ff00; font-weight: 700; horizontal-stretch: 1; }
                    Text { text: "$" + root.total; color: #00ff00; font-weight: 700; }
                }

                Rectangle { height: 10px; }

                // Payment mode
                Text { text: "Payment Mode"; color: #00ffff; font-size: 14px; horizontal-alignment: center; }
                HorizontalLayout {
                    spacing: 4px;
                    Rectangle { horizontal-stretch: 1; height: 30px; background: root.payment-mode == 1 ? #00aa00 : #505050; border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 1; } }
                        Text { text: "Cash"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { horizontal-stretch: 1; height: 30px; background: root.payment-mode == 2 ? #00aa00 : #505050; border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 2; } }
                        Text { text: "UPI"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { horizontal-stretch: 1; height: 30px; background: root.payment-mode == 3 ? #00aa00 : #505050; border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 3; } }
                        Text { text: "Card"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { horizontal-stretch: 1; height: 30px; background: root.payment-mode == 4 ? #00aa00 : #505050; border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 4; } }
                        Text { text: "Split"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                    Rectangle { horizontal-stretch: 1; height: 30px; background: root.payment-mode == 5 ? #00aa00 : #505050; border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 5; } }
                        Text { text: "Due"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                }

                // Split payment inputs (expandable vertically)
                if root.payment-mode == 4 : Rectangle {
                    background: #303030;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        HorizontalLayout {
                            Text { text: "Cash:"; color: white; width: 60px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; height: cash-input.preferred-height + 12px; background: #ffffcc; border-radius: 2px; clip: true;
                                cash-input := TextInput { horizontal-stretch: 1; height: 100%; color: black; wrap: word-wrap; text: ""; } }
                        }
                        HorizontalLayout {
                            Text { text: "UPI:"; color: white; width: 60px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; height: upi-input.preferred-height + 12px; background: #ffffcc; border-radius: 2px; clip: true;
                                upi-input := TextInput { horizontal-stretch: 1; height: 100%; color: black; wrap: word-wrap; text: ""; } }
                        }
                        HorizontalLayout {
                            Text { text: "Card:"; color: white; width: 60px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; height: card-input.preferred-height + 12px; background: #ffffcc; border-radius: 2px; clip: true;
                                card-input := TextInput { horizontal-stretch: 1; height: 100%; color: black; wrap: word-wrap; text: ""; } }
                        }
                    }
                }

                Rectangle { height: 10px; }

                // Action buttons
                Rectangle { height: 40px; background: save-hover.has-hover ? #005500 : #004400; border-radius: 6px;
                    save-hover := TouchArea { clicked => { root.save(); } }
                    Text { text: "Save & Close"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { height: 40px; background: print-hover.has-hover ? #555500 : #444400; border-radius: 6px;
                    print-hover := TouchArea { clicked => { root.print(); } }
                    Text { text: "Print Bill"; color: white; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { height: 40px; background: close-hover.has-hover ? #880000 : #660000; border-radius: 6px;
                    close-hover := TouchArea { clicked => { root.go-back(); } }
                    Text { text: "Dashboard"; color: white; horizontal-alignment: center; vertical-alignment: center; } }

                // Customer details section (expandable vertically)
                Text { text: "Customer Details"; color: #00ffff; font-size: 14px; horizontal-alignment: center; }
                HorizontalLayout {
                    Text { text: "Name:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; height: customer-name-input.preferred-height + 12px; background: #ccffff; border-radius: 2px; clip: true;
                        customer-name-input := TextInput { horizontal-stretch: 1; height: 100%; color: black; wrap: word-wrap; text <=> root.customer-name; } }
                }
                HorizontalLayout {
                    Text { text: "Phone:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; height: customer-phone-input.preferred-height + 12px; background: #ccffff; border-radius: 2px; clip: true;
                        customer-phone-input := TextInput { horizontal-stretch: 1; height: 100%; color: black; wrap: word-wrap; text <=> root.customer-phone; } }
                }
                HorizontalLayout {
                    Text { text: "Address:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; height: customer-address-input.preferred-height + 12px; background: #ccffff; border-radius: 2px; clip: true;
                        customer-address-input := TextInput { horizontal-stretch: 1; height: 100%; color: black; wrap: word-wrap; text <=> root.customer-address; } }
                }

                // Change table section (no "New")
                Text { text: "Change Table"; color: #00ffff; font-size: 14px; horizontal-alignment: center; }
                HorizontalLayout {
                    Text { text: "Current:"; color: white; width: 60px; vertical-alignment: center; }
                    Text { text: root.table-name; color: #00ff00; horizontal-stretch: 1; vertical-alignment: center; }
                }
                HorizontalLayout {
                    Text { text: "Table:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; height: table-input.preferred-height + 12px; background: #ccffcc; border-radius: 2px; clip: true;
                        table-input := TextInput { horizontal-stretch: 1; height: 100%; color: black; wrap: word-wrap; text <=> root.new-table; } }
                }
                HorizontalLayout {
                    Text { text: "Area:"; color: white; width: 60px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; height: area-input.preferred-height + 12px; background: #ccffcc; border-radius: 2px; clip: true;
                        area-input := TextInput { horizontal-stretch: 1; height: 100%; color: black; wrap: word-wrap; text <=> root.new-area; } }
                }
                Rectangle { height: 30px; background: move-hover.has-hover ? #444444 : #333333; border-radius: 4px;
                    move-hover := TouchArea { clicked => { /* future: move table */ } }
                    Text { text: "Move Table"; color: white; horizontal-alignment: center; vertical-alignment: center; } }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
