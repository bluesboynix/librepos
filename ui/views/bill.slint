import { MenuItem, OrderLine } from "../db-types.slint";

export component BillView inherits Rectangle {
    width: 100%;
    height: 100%;

    in-out property <string> table-name: "Table";
    in-out property <int> payment-mode: 0;
    in-out property <string> search-text: "";
    in-out property <string> instructions: "";
    in-out property <string> customer-name: "";
    in-out property <string> customer-phone: "";
    in-out property <string> customer-address: "";
    in-out property <string> new-table: "";
    in-out property <string> new-area: "";
    in-out property <string> bill-no: "001";
    in property <[MenuItem]> menu-items;
    in property <[OrderLine]> order-lines;
    in-out property <string> discount-text: "0.00";
    in-out property <string> delivery-text: "0.00";
    in-out property <string> packaging-text: "0.00";
    in property <float> subtotal;
    in property <float> gst;
    in property <float> total;
    in property <string> currency: "₹";

    callback go-back();
    callback save();
    callback print();
    callback print-order();
    callback add-order-line(string, float);
    callback update-order-line-quantity(int, int);
    callback remove-order-line(int);
    callback recalculate();

    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding: 15px;
        spacing: 15px;

        // ----- Left column: Menu (30%) -----
        Rectangle {
            width: 30%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Menu";
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Search box
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.search-text;
                        }
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: clear-search-hover.has-hover ? #aaaaaa : #cccccc;
                            border-radius: 10px;
                            clear-search-hover := TouchArea {
                                clicked => { root.search-text = ""; }
                            }
                            Text {
                                text: "×";
                                color: black;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Dynamic menu items
                for item[i] in root.menu-items : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 8px;

                        Text {
                            text: item.name;
                            color: white;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: item.category;
                            color: #cccccc;
                            font-size: 12px;
                        }
                        Text {
                            text: root.currency + item.price;
                            color: white;
                        }
                        Rectangle {
                            width: 26px;
                            height: 26px;
                            background: add-hover.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            add-hover := TouchArea {
                                clicked => { root.add-order-line(item.name, item.price); }
                            }
                            Text {
                                text: "+";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // ----- Center column: Order (40%) -----
        Rectangle {
            width: 40%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Order - " + root.table-name;
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                // Order lines
                for line[i] in root.order-lines : Rectangle {
                    height: 36px;
                    background: #505050;
                    border-radius: 4px;
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 8px;

                        Text {
                            text: line.name;
                            color: white;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.currency + line.price;
                            color: white;
                        }
                        Text {
                            text: "x" + line.quantity;
                            color: white;
                        }
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: dec-hover.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            dec-hover := TouchArea {
                                clicked => { root.update-order-line-quantity(i, line.quantity - 1); }
                            }
                            Text {
                                text: "-";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 20px;
                            height: 20px;
                            background: inc-hover.has-hover ? #888888 : #666666;
                            border-radius: 4px;
                            inc-hover := TouchArea {
                                clicked => { root.update-order-line-quantity(i, line.quantity + 1); }
                            }
                            Text {
                                text: "+";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 30px;
                            height: 20px;
                            background: remove-hover.has-hover ? #aa3333 : #883333;
                            border-radius: 4px;
                            remove-hover := TouchArea {
                                clicked => { root.remove-order-line(i); }
                            }
                            Text {
                                text: "X";
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                font-size: 12px;
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                // Instructions input
                Rectangle {
                    horizontal-stretch: 1;
                    height: instructions-input.preferred-height + 12px;
                    background: #d0d0d0;
                    border-radius: 4px;
                    clip: true;
                    HorizontalLayout {
                        padding: 6px;
                        instructions-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            wrap: word-wrap;
                            text <=> root.instructions;
                        }
                    }
                }

                // Print Order button
                Rectangle {
                    height: 40px;
                    background: print-order-hover.has-hover ? #444444 : #333333;
                    border-radius: 6px;
                    print-order-hover := TouchArea {
                        clicked => { root.print-order(); }
                    }
                    Text {
                        text: "Print Order";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ----- Right column: Summary (30%) -----
        Rectangle {
            width: 30%;
            height: 100%;
            background: #404040;
            border-radius: 8px;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                Text {
                    text: "Bill Summary";
                    color: #00ffff;
                    font-size: 18px;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    Text {
                        text: "Bill No:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.bill-no;
                        color: white;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }

                // Subtotal
                HorizontalLayout {
                    Text {
                        text: "Subtotal:";
                        color: white;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.currency + root.subtotal;
                        color: white;
                    }
                }

                // GST
                HorizontalLayout {
                    Text {
                        text: "GST (5%):";
                        color: white;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.currency + root.gst;
                        color: white;
                    }
                }

                // Packaging charge
                HorizontalLayout {
                    Text {
                        text: "Packaging:";
                        color: white;
                        width: 80px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #d0d0d0;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.packaging-text;
                            edited => { root.recalculate(); }
                        }
                    }
                }

                // Delivery charge
                HorizontalLayout {
                    Text {
                        text: "Delivery:";
                        color: white;
                        width: 80px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #d0d0d0;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.delivery-text;
                            edited => { root.recalculate(); }
                        }
                    }
                }

                // Discount
                HorizontalLayout {
                    Text {
                        text: "Discount:";
                        color: white;
                        width: 80px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #d0d0d0;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.discount-text;
                            edited => { root.recalculate(); }
                        }
                    }
                }

                // Total
                HorizontalLayout {
                    Text {
                        text: "Total:";
                        color: #00ff00;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.currency + root.total;
                        color: #00ff00;
                        font-weight: 700;
                    }
                }

                Rectangle { height: 10px; }

                Text {
                    text: "Payment Mode";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 1 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 1; } }
                        Text {
                            text: "Cash";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 2 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 2; } }
                        Text {
                            text: "UPI";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 3 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 3; } }
                        Text {
                            text: "Card";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 4 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 4; } }
                        Text {
                            text: "Split";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        background: root.payment-mode == 5 ? #00aa00 : #505050;
                        border-radius: 4px;
                        TouchArea { clicked => { root.payment-mode = 5; } }
                        Text {
                            text: "Due";
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.payment-mode == 4 : Rectangle {
                    background: #303030;
                    border-radius: 4px;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        HorizontalLayout {
                            Text {
                                text: "Cash:";
                                color: white;
                                width: 60px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                background: #ffffcc;
                                border-radius: 2px;
                                clip: true;
                                TextInput {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    color: black;
                                    single-line: true;
                                    text: "";
                                }
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "UPI:";
                                color: white;
                                width: 60px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                background: #ffffcc;
                                border-radius: 2px;
                                clip: true;
                                TextInput {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    color: black;
                                    single-line: true;
                                    text: "";
                                }
                            }
                        }
                        HorizontalLayout {
                            Text {
                                text: "Card:";
                                color: white;
                                width: 60px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 26px;
                                background: #ffffcc;
                                border-radius: 2px;
                                clip: true;
                                TextInput {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    color: black;
                                    single-line: true;
                                    text: "";
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 10px; }

                Rectangle {
                    height: 40px;
                    background: save-hover.has-hover ? #005500 : #004400;
                    border-radius: 6px;
                    save-hover := TouchArea { clicked => { root.save(); } }
                    Text {
                        text: "Save & Close";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 40px;
                    background: print-hover.has-hover ? #555500 : #444400;
                    border-radius: 6px;
                    print-hover := TouchArea { clicked => { root.print(); } }
                    Text {
                        text: "Print Bill";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 40px;
                    background: close-hover.has-hover ? #880000 : #660000;
                    border-radius: 6px;
                    close-hover := TouchArea { clicked => { root.go-back(); } }
                    Text {
                        text: "Dashboard";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Customer details
                Text {
                    text: "Customer Details";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    Text {
                        text: "Name:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffff;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.customer-name;
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Phone:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffff;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.customer-phone;
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Address:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffff;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.customer-address;
                        }
                    }
                }

                // Change table
                Text {
                    text: "Change Table";
                    color: #00ffff;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    Text {
                        text: "Current:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.table-name;
                        color: #00ff00;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Table:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffcc;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.new-table;
                        }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: "Area:";
                        color: white;
                        width: 60px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 26px;
                        background: #ccffcc;
                        border-radius: 2px;
                        clip: true;
                        TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            color: black;
                            single-line: true;
                            text <=> root.new-area;
                        }
                    }
                }
                Rectangle {
                    height: 30px;
                    background: move-hover.has-hover ? #444444 : #333333;
                    border-radius: 4px;
                    move-hover := TouchArea { clicked => { /* future */ } }
                    Text {
                        text: "Move Table";
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
