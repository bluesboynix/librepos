import { MenuItem } from "../db-types.slint";

export component MenuView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[MenuItem]> items;
    in property <string> currency: "₹";
    in-out property <string> search-text: "";
    callback search-changed(string);
    callback add-item();
    callback remove-item(int);
    callback open-item(int);

    VerticalLayout {
        padding: 20px;
        spacing: 10px;

        Text {
            text: "Menu";
            font-size: 24px;
            color: #fafafa;
            horizontal-alignment: center;
        }

        // Search box
        Rectangle {
            horizontal-stretch: 1;
            height: 30px;
            background: #d0d0d0;
            border-radius: 4px;
            clip: true;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                TextInput {
                    horizontal-stretch: 1;
                    height: 100%;
                    color: black;
                    single-line: true;
                    text <=> root.search-text;
                    edited => { root.search-changed(self.text); }
                }
                Rectangle {
                    width: 20px;
                    height: 20px;
                    background: clear-hover.has-hover ? #aaaaaa : #cccccc;
                    border-radius: 10px;
                    clear-hover := TouchArea {
                        clicked => {
                            root.search-text = "";
                            root.search-changed("");
                        }
                    }
                    Text {
                        text: "×";
                        color: black;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            height: 30px;
            width: 120px;
            background: add-button-hover.has-hover ? #444444 : #333333;
            border-radius: 4px;
            add-button-hover := TouchArea {
                clicked => { root.add-item(); }
            }
            Text {
                text: "+ Add Item";
                color: white;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Items list
        for item[i] in root.items : Rectangle {
            height: 40px;
            background: Math.mod(i, 2) == 0 ? #404040 : #505050;
            border-radius: 6px;
            HorizontalLayout {
                padding: 10px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;
                    background: name-area.has-hover ? #606060 : transparent;
                    border-radius: 4px;
                    name-area := TouchArea {
                        clicked => { root.open-item(i); }
                    }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: item.name;
                        color: white;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                }

                Text {
                    text: root.currency + item.price;
                    color: white;
                    width: 80px;
                    vertical-alignment: center;
                }
                Text {
                    text: item.category;
                    color: white;
                    width: 100px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 60px;
                    height: 24px;
                    background: delete-hover.has-hover ? #aa3333 : #883333;
                    border-radius: 4px;
                    delete-hover := TouchArea {
                        clicked => { root.remove-item(i); }
                    }
                    Text {
                        text: "Remove";
                        color: white;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
