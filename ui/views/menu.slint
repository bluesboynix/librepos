import { MenuItem } from "../db-types.slint";
import { Theme } from "../theme.slint";
import { CategoryTabs } from "../components/category_tabs.slint";
import { SearchBox } from "../components/search_box.slint";

export component MenuView inherits Rectangle {
    width: 100%;
    height: 100%;

    in property <[MenuItem]> items;
    in property <[string]> categories;
    in property <string> currency: "₹";
    in-out property <string> search-text: "";
    in-out property <string> active-category: "";
    in-out property <bool> focus-search-requested: false;

    callback filter-changed(string, string);
    callback add-item();
    callback remove-item(int);
    callback open-item(int);
    callback key-pressed(string, bool, bool, bool, bool) -> bool;

    VerticalLayout {
        padding: 20px;
        spacing: 10px;

        Text {
            text: "Menu";
            font-size: 28px;
            color: #fafafa;
            horizontal-alignment: center;
        }

        CategoryTabs {
            categories: root.categories;
            active <=> root.active-category;
            changed(cat) => {
                root.filter-changed(root.search-text, cat);
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 36px;
            background: #d0d0d0;
            border-radius: 4px;
            clip: true;

            SearchBox {
                height: 36px;
                text-size: 15px;
                text <=> root.search-text;
                focus-requested <=> root.focus-search-requested;
                edited(t) => {
                    root.filter-changed(t, root.active-category);
                }
                key-pressed(text, ctrl, shift, alt, meta) => {
                    root.key-pressed(text, ctrl, shift, alt, meta)
                }
            }
            
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                search-box := TextInput {
                    horizontal-stretch: 1;
                    height: 100%;
                    color: black;
                    single-line: true;
                    font-size: 15px;
                    vertical-alignment: center;
                    text <=> root.search-text;
                    edited => {
                        root.filter-changed(self.text, root.active-category);
                    }
                }
                Rectangle {
                    width: 22px;
                    height: 22px;
                    background: clear-hover.has-hover ? #aaaaaa : #cccccc;
                    border-radius: 11px;
                    clear-hover := TouchArea {
                        clicked => {
                            root.search-text = "";
                            root.filter-changed("", root.active-category);
                        }
                    }
                    Text {
                        text: "×";
                        color: black;
                        font-size: 15px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            height: 34px;
            width: 140px;
            background: add-button-hover.has-hover ? #444444 : #333333;
            border-radius: 4px;
            add-button-hover := TouchArea {
                clicked => { root.add-item(); }
            }
            Text {
                text: "+ Add Item";
                color: white;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        for item[i] in root.items : Rectangle {
            height: 48px;
            background: Math.mod(i, 2) == 0 ? #404040 : #505050;
            border-radius: 6px;
            HorizontalLayout {
                padding: 12px;
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;
                    background: name-area.has-hover ? #606060 : transparent;
                    border-radius: 4px;
                    name-area := TouchArea {
                        clicked => { root.open-item(item.id); }
                    }
                    Text {
                        width: 100%;
                        height: 100%;
                        text: item.name;
                        color: white;
                        font-size: 16px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                }

                Text {
                    text: root.currency + item.price;
                    color: white;
                    font-size: 16px;
                    width: 100px;
                    vertical-alignment: center;
                }
                Text {
                    text: item.category;
                    color: white;
                    font-size: 14px;
                    width: 120px;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 70px;
                    height: 28px;
                    background: delete-hover.has-hover ? #aa3333 : #883333;
                    border-radius: 4px;
                    delete-hover := TouchArea {
                        clicked => { root.remove-item(item.id); }
                    }
                    Text {
                        text: "Remove";
                        color: white;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
