import { ReportSummary, ReportItem, ReportPayment, ReportDay, ReportBill, BillDetail } from "../db-types.slint";
import { Theme } from "../theme.slint";
import { DateRangeBar } from "../components/date_range_bar.slint";
import { ReportsTabs } from "../components/reports_tabs.slint";
import { ReportSummaryView } from "reports/summary.slint";
import { ReportItemsView } from "reports/items.slint";
import { ReportPaymentsView } from "reports/payments.slint";
import { ReportDailyView } from "reports/daily.slint";
import { ReportBillsView } from "reports/bills.slint";

export component ReportsView inherits Rectangle {
    width: 100%;
    height: 100%;

    in-out property <string> bills-search-text: "";
    callback filter-bills(string);
    in-out property <string> from-date: "";
    in-out property <string> to-date: "";
    in-out property <int> active-tab: 0;
    in-out property <int> active-range: 0;
    in property <ReportSummary> summary;
    in property <[ReportItem]> top-items;
    in property <[ReportPayment]> payment-breakdown;
    in property <[ReportDay]> daily-sales;
    in property <[ReportBill]> bills;
    in property <float> max-daily-sale: 0.0;
    in property <string> max-daily-sale-text: "0.00";
    in property <[string]> y-labels;
    in property <string> currency: "₹";
    in property <BillDetail> current-bill-detail;
    in-out property <bool> bills-detail-open: false;
    in-out property <bool> bills-show-voided: false;

    callback refresh(string, string);
    callback quick-range(int);
    callback load-bill-detail(int);
    callback clear-bill-detail();
    callback void-bill();
    callback revive();
    callback toggle-voided();
    callback edit-bill();

    VerticalLayout {
        padding: 15px;
        spacing: Theme.pad-md;

        Text {
            text: "Reports";
            font-size: 22px;
            color: #fafafa;
            horizontal-alignment: center;
        }

        DateRangeBar {
            from-date <=> root.from-date;
            to-date <=> root.to-date;
            active-range <=> root.active-range;
            show(from, to) => { root.refresh(from, to); }
            quick-range(kind) => { root.quick-range(kind); }
        }

        ReportsTabs {
            active-tab <=> root.active-tab;
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-panel-alt;
            border-radius: Theme.radius-md;
            clip: true;

            if root.active-tab == 0 : ReportSummaryView {
                summary: root.summary;
                currency: root.currency;
                days: root.daily-sales;
                max-daily-sale: root.max-daily-sale;
                max-daily-sale-text: root.max-daily-sale-text;
                y-labels: root.y-labels;
            }
            if root.active-tab == 1 : ReportItemsView {
                items: root.top-items;
                currency: root.currency;
            }
            if root.active-tab == 2 : ReportPaymentsView {
                payments: root.payment-breakdown;
                currency: root.currency;
            }
            if root.active-tab == 3 : ReportDailyView {
                days: root.daily-sales;
                currency: root.currency;
            }
            if root.active-tab == 4 : ReportBillsView {
                bills: root.bills;
                currency: root.currency;
                detail: root.current-bill-detail;
                detail-open <=> root.bills-detail-open;
                show-voided <=> root.bills-show-voided;
                bill-selected(order-id) => { root.load-bill-detail(order-id); }
                back-to-list => { root.clear-bill-detail(); }
                void-bill => { root.void-bill(); }
                revive => { root.revive(); }
                toggle-voided => { root.toggle-voided(); }
                edit-bill => { root.edit-bill(); }
                search-text <=> root.bills-search-text;
                search-changed(query) => { root.filter-bills(query); }
            }
        }
    }
}
